{
  "name": "@exodus/edem-electrobun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Edem Electrobun Integration — desktop runtime bridge for Edem modules",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bun": {
      "types": "./src/bun.ts",
      "default": "./src/bun.ts"
    },
    "./webview": {
      "types": "./src/webview.ts",
      "default": "./src/webview.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./module": {
      "types": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./window": {
      "types": "./src/window.ts",
      "default": "./src/window.ts"
    },
    "./system": {
      "types": "./src/system.ts",
      "default": "./src/system.ts"
    },
    "./logger-bun": {
      "types": "./src/logger-bun.ts",
      "default": "./src/logger-bun.ts"
    },
    "./logger-webview": {
      "types": "./src/logger-webview.ts",
      "default": "./src/logger-webview.ts"
    }
  },
  "dependencies": {
    "@exodus/edem-core": "workspace:*",
    "@exodus/edem-data": "workspace:*",
    "electrobun": "1.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@exodus/typescript-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/three": "0.185.1",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test"
  }
}
