{
  "component": "div",
  "props": {
    "class": "flex h-full"
  },
  "children": [
    {
      "component": "MenuLayout",
      "props": {
        "title": {
          "$type": "translation",
          "en": "Settings",
          "ru": "Настройки"
        },
        "items": "{{ navItems }}",
