{
  "component": "div",
  "props": {
    "class": "flex h-full flex-col p-6"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "mb-4 flex items-center justify-between"
      },
      "children": [
        {
          "component": "h2",
          "props": {
            "class": "text-lg font-semibold"
          },
          "children": {
            "$type": "translation",
            "en": "Ideas",
            "ru": "Идеи"
          }
        },
        {
          "component": "UButton",
          "props": {
            "size": "sm"
          },
          "events": {
            "click": {
              "flow": "createIdea",
              "input": {
                "projectId": "{{ id }}"
              }
            }
          },
          "children": [
            {
              "component": "UIcon",
              "props": {
                "name": "i-lucide-plus",
                "class": "h-4 w-4"
              }
            },
            "New Idea"
          ]
        }
      ]
    },
    {
      "component": "div",
      "skeleton": true
    },
    {
      "component": "div",
      "empty": {
        "icon": "i-lucide-lightbulb",
        "text": {
          "$type": "translation",
          "en": "No ideas yet",
          "ru": "Пока нет идей"
        },
        "action": {
          "component": "UButton",
          "props": {
            "size": "sm"
          },
          "events": {
            "click": {
              "flow": "createIdea",
              "input": {
                "projectId": "{{ id }}"
              }
            }
          },
          "children": {
            "$type": "translation",
            "en": "Create first idea",
            "ru": "Создать первую идею"
          }
        }
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-2"
          },
          "bind": {
            "collection": "ideas",
            "filter": {
              "project_id": {
                "_eq": "{{ id }}"
              }
            },
            "sort": [
              "-created_at"
            ],
            "item": {
              "component": "RouterLink",
              "props": {
                "to": "/project/{{ id }}/ideas/{{ item.id }}",
                "class": "flex items-center gap-3 rounded-lg border border-[var(--ui-border)] p-4 transition-colors hover:bg-[var(--ui-bg-elevated)]"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "bg-primary/10 text-primary flex h-8 w-8 flex-shrink-0 items-center justify-center rounded text-xs font-bold"
                  },
                  "children": "{{ item.level ?? '?' }}"
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ item.title }}"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "text-xs text-[var(--ui-text-muted)]"
                      },
                      "children": "{{ item.type }}"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
