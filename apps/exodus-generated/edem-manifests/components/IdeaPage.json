{
  "component": "div",
  "props": {
    "class": "flex h-full flex-col"
  },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": {
        "class": "flex h-full items-center justify-center"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-loader-2",
            "class": "text-muted h-8 w-8 animate-spin"
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !idea }}",
      "props": {
        "class": "text-muted flex h-full flex-col items-center justify-center gap-2"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-file-x",
            "class": "h-12 w-12 opacity-20"
          }
        },
        {
          "component": "p",
          "children": {
            "$type": "translation",
            "en": "Idea not found",
            "ru": "Идея не найдена"
          }
        },
        {
          "component": "UButton",
          "props": {
            "to": "{{ backLink }}",
            "variant": "link"
          },
          "children": {
            "$type": "translation",
            "en": "Back to ideas",
            "ru": "Назад к идеям"
          }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": {
        "class": "flex flex-1 flex-col gap-6 overflow-y-auto"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "border-default flex items-center justify-between border-b px-6 py-3"
          },
          "children": [
            {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3"
              },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "to": "{{ backLink }}",
                    "variant": "ghost",
                    "size": "sm",
                    "icon": "i-lucide-arrow-left"
                  },
                  "children": {
                    "$type": "translation",
                    "en": "Back to ideas",
                    "ru": "Назад к идеям"
                  }
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-wrap items-center gap-2"
                  },
                  "children": [
                    {
                      "component": "UBadge",
                      "props": {
                        "label": "{{ idea.data.level || t({ en: 'No level', ru: 'Без уровня' }) }}",
                        "color": "neutral",
                        "variant": "subtle",
                        "class": "bg-primary/10 text-primary text-xs font-semibold"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.data.type }}",
                      "props": {
                        "label": "{{ idea.data.type }}",
                        "color": "neutral",
                        "variant": "soft",
                        "size": "sm"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.data.status === 'stabilized' }}",
                      "props": {
                        "label": {
                          "$type": "translation",
                          "en": "Stabilized",
                          "ru": "Стабилизирована"
                        },
                        "color": "success",
                        "variant": "subtle",
                        "size": "sm"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "component": "UButton",
              "props": {
                "color": "error",
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-trash-2"
              },
              "events": {
                "click": {
                  "action": "openDeleteModal"
                }
              },
              "children": {
                "$type": "translation",
                "en": "Delete",
                "ru": "Удалить"
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-6 px-6 pb-6"
          },
          "children": [
            {
              "component": "UInput",
              "props": {
                "vModel": "{{ title }}",
                "size": "lg",
                "class": "w-full"
              },
              "events": {
                "blur": {
                  "action": "updateTitle"
                },
                "keyup.enter": {
                  "action": "updateTitle"
                }
              }
            },
            {
              "component": "UTextarea",
              "props": {
                "vModel": "{{ description }}",
                "placeholder": {
                  "$type": "translation",
                  "en": "Idea description (optional)",
                  "ru": "Описание идеи (опционально)"
                },
                "rows": 6,
                "class": "w-full"
              },
              "events": {
                "blur": {
                  "action": "updateDescription"
                }
              }
            },
            {
              "component": "div",
              "props": {
                "class": "grid grid-cols-3 gap-4"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Level",
                        "ru": "Уровень"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "vModel": "{{ level }}",
                        "items": "{{ levelItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Type",
                        "ru": "Тип"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "vModel": "{{ typeValue }}",
                        "items": "{{ typeItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Status",
                        "ru": "Статус"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "vModel": "{{ status }}",
                        "items": "{{ statusItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": {
              "$type": "translation",
              "en": "Delete idea?",
              "ru": "Удалить идею?"
            },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this idea? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить эту идею? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": {
                  "variant": "ghost"
                },
                "events": {
                  "click": {
                    "expression": "deleteModalOpen = false"
                  }
                },
                "children": {
                  "$type": "translation",
                  "en": "Cancel",
                  "ru": "Отмена"
                }
              },
              {
                "component": "UButton",
                "props": {
                  "color": "error"
                },
                "events": {
                  "click": {
                    "action": "confirmDelete"
                  }
                },
                "children": {
                  "$type": "translation",
                  "en": "Delete",
                  "ru": "Удалить"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "rawScript": "import { useRoute, useRouter } from 'vue-router'\nimport { computed, ref, watch, nextTick } from 'vue'\nimport { useCollectionQuery, useUpdateItem, useDeleteItem } from '@/hooks'\n\nconst route = useRoute()\nconst router = useRouter()\nconst projectId = computed(() => route.params.id as string)\nconst ideaId = computed(() => route.params.ideaId as string)\n\nconst { data: ideas, loading } = useCollectionQuery('ideas', () => ({\n  filter: { project_id: { _eq: projectId.value } },\n}))\nconst [updateItem] = useUpdateItem()\nconst [deleteItem] = useDeleteItem()\n\nconst idea = computed(() => ideas.value.find((i) => i.id === ideaId.value) ?? null)\n\nconst backLink = computed(() => `/project/${projectId.value}/ideas`)\n\nconst deleteModalOpen = ref(false)\n\nconst title = ref('')\nconst description = ref('')\nconst level = ref<string | null>(null)\nconst typeValue = ref<string | null>(null)\nconst status = ref<string>('draft')\nconst isInitialized = ref(false)\n\nwatch(\n  idea,\n  (i) => {\n    if (!i) return\n    title.value = i.data.title ?? ''\n    description.value = i.data.description ?? ''\n    level.value = i.data.level ?? null\n    typeValue.value = i.data.type ?? null\n    status.value = i.data.status ?? 'draft'\n    nextTick(() => {\n      isInitialized.value = true\n    })\n  },\n  { immediate: true },\n)\n\nfunction updateTitle() {\n  if (!idea.value) return\n  const trimmed = title.value.trim()\n  if (trimmed === '') {\n    title.value = idea.value.data.title ?? ''\n    return\n  }\n  if (trimmed === idea.value.data.title) return\n  updateItem(idea.value.id, { title: trimmed })\n}\n\nfunction updateDescription() {\n  if (!idea.value || description.value === (idea.value.data.description ?? '')) return\n  updateItem(idea.value.id, { description: description.value || null })\n}\n\nwatch(level, (v) => {\n  if (!isInitialized.value || !idea.value || v === idea.value.data.level) return\n  updateItem(idea.value.id, { level: v })\n})\n\nwatch(typeValue, (v) => {\n  if (!isInitialized.value || !idea.value || v === idea.value.data.type) return\n  updateItem(idea.value.id, { type: v })\n})\n\nwatch(status, (v) => {\n  if (!isInitialized.value || !idea.value || v === idea.value.data.status) return\n  updateItem(idea.value.id, { status: v })\n})\n\nfunction openDeleteModal() {\n  deleteModalOpen.value = true\n}\n\nfunction confirmDelete() {\n  if (!idea.value) return\n  deleteItem(idea.value.id)\n  deleteModalOpen.value = false\n  router.push(`/project/${projectId.value}/ideas`)\n}\n\nconst LEVELS = ['L0', 'L1', 'L2', 'L3', 'L4']\nconst TYPES = ['goal', 'non_goal', 'constraint', 'invariant', 'component', 'decision', 'principle']\n\nconst levelItems = [\n  { label: t({ en: 'No level', ru: 'Без уровня' }), value: null },\n  ...LEVELS.map((l) => ({ label: l, value: l })),\n]\n\nconst typeItems = [\n  { label: t({ en: 'No type', ru: 'Без типа' }), value: null },\n  ...TYPES.map((type) => ({ label: type, value: type })),\n]\n\nconst statusItems = [\n  { label: t({ en: 'Draft', ru: 'Черновик' }), value: 'draft' },\n  { label: t({ en: 'Stabilized', ru: 'Стабилизирована' }), value: 'stabilized' },\n]"
}