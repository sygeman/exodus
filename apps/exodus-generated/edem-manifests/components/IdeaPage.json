{
  "component": "div",
  "queries": {
    "ideas": {
      "collection": "ideas",
      "filter": {
        "project_id": {
          "_eq": "{{ route.params.id }}"
        }
      }
    }
  },
  "state": {
    "deleteModalOpen": false
  },
  "constants": {
    "levelItems": [
      {
        "label": "L1",
        "value": "L1"
      },
      {
        "label": "L2",
        "value": "L2"
      },
      {
        "label": "L3",
        "value": "L3"
      },
      {
        "label": "L4",
        "value": "L4"
      }
    ],
    "typeItems": [
      {
        "label": "goal",
        "value": "goal"
      },
      {
        "label": "non_goal",
        "value": "non_goal"
      },
      {
        "label": "constraint",
        "value": "constraint"
      },
      {
        "label": "invariant",
        "value": "invariant"
      },
      {
        "label": "component",
        "value": "component"
      },
      {
        "label": "decision",
        "value": "decision"
      },
      {
        "label": "principle",
        "value": "principle"
      }
    ],
    "statusItems": [
      {
        "label": "draft",
        "value": "draft"
      },
      {
        "label": "stabilized",
        "value": "stabilized"
      }
    ]
  },
  "computed": {
    "idea": "{{ ideas.value.find((entry) => entry.id === route.params.ideaId) ?? null }}",
    "loading": "{{ ideasLoading.value }}",
    "backLink": "{{ `/project/${route.params.id}/ideas` }}"
  },
  "actions": {
    "openDeleteModal": {
      "steps": [
        {
          "type": "set-state",
          "state": "deleteModalOpen",
          "value": true
        }
      ]
    },
    "closeDeleteModal": {
      "steps": [
        {
          "type": "set-state",
          "state": "deleteModalOpen",
          "value": false
        }
      ]
    },
    "confirmDelete": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "delete-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}"
        },
        {
          "type": "set-state",
          "state": "deleteModalOpen",
          "value": false
        },
        {
          "type": "navigate",
          "to": "{{ backLink.value }}"
        }
      ]
    },
    "updateTitle": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "guard",
          "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() !== '' }}"
        },
        {
          "type": "guard",
          "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() !== (idea.value.title ?? '') }}"
        },
        {
          "type": "update-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}",
          "data": {
            "title": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() }}"
          }
        }
      ]
    },
    "updateDescription": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "guard",
          "condition": "{{ (((($event as FocusEvent).target) as HTMLTextAreaElement).value) !== (idea.value.description ?? '') }}"
        },
        {
          "type": "update-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}",
          "data": {
            "description": "{{ (((($event as FocusEvent).target) as HTMLTextAreaElement).value) || null }}"
          }
        }
      ]
    },
    "updateLevel": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "guard",
          "condition": "{{ $event !== idea.value.level }}"
        },
        {
          "type": "update-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}",
          "data": {
            "level": "{{ $event }}"
          }
        }
      ]
    },
    "updateType": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "guard",
          "condition": "{{ $event !== idea.value.type }}"
        },
        {
          "type": "update-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}",
          "data": {
            "type": "{{ $event }}"
          }
        }
      ]
    },
    "updateStatus": {
      "steps": [
        {
          "type": "guard",
          "condition": "{{ idea.value }}"
        },
        {
          "type": "guard",
          "condition": "{{ $event !== idea.value.status }}"
        },
        {
          "type": "update-item",
          "collection": "ideas",
          "id": "{{ idea.value.id }}",
          "data": {
            "status": "{{ $event }}"
          }
        }
      ]
    }
  },
  "props": {
    "class": "flex h-full flex-col"
  },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": {
        "class": "flex h-full items-center justify-center"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-loader-2",
            "class": "text-muted h-8 w-8 animate-spin"
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !idea }}",
      "props": {
        "class": "text-muted flex h-full flex-col items-center justify-center gap-2"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-file-x",
            "class": "h-12 w-12 opacity-20"
          }
        },
        {
          "component": "p",
          "children": {
            "$type": "translation",
            "en": "Idea not found",
            "ru": "Идея не найдена"
          }
        },
        {
          "component": "UButton",
          "props": {
            "to": "{{ backLink }}",
            "variant": "link"
          },
          "children": {
            "$type": "translation",
            "en": "Back to ideas",
            "ru": "Назад к идеям"
          }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": {
        "class": "flex flex-1 flex-col gap-6 overflow-y-auto"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "border-default flex items-center justify-between border-b px-6 py-3"
          },
          "children": [
            {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3"
              },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "to": "{{ backLink }}",
                    "variant": "ghost",
                    "size": "sm",
                    "icon": "i-lucide-arrow-left"
                  },
                  "children": {
                    "$type": "translation",
                    "en": "Back to ideas",
                    "ru": "Назад к идеям"
                  }
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-wrap items-center gap-2"
                  },
                  "children": [
                    {
                      "component": "UBadge",
                      "props": {
                        "label": "{{ idea.level || t({ en: 'No level', ru: 'Без уровня' }) }}",
                        "color": "neutral",
                        "variant": "subtle",
                        "class": "bg-primary/10 text-primary text-xs font-semibold"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.type }}",
                      "props": {
                        "label": "{{ idea.type }}",
                        "color": "neutral",
                        "variant": "soft",
                        "size": "sm"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.status === 'stabilized' }}",
                      "props": {
                        "label": {
                          "$type": "translation",
                          "en": "Stabilized",
                          "ru": "Стабилизирована"
                        },
                        "color": "success",
                        "variant": "subtle",
                        "size": "sm"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "component": "UButton",
              "props": {
                "color": "error",
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-trash-2"
              },
              "events": {
                "click": {
                  "action": "openDeleteModal"
                }
              },
              "children": {
                "$type": "translation",
                "en": "Delete",
                "ru": "Удалить"
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-6 px-6 pb-6"
          },
          "children": [
            {
              "component": "UInput",
              "props": {
                "modelValue": "{{ idea.title ?? '' }}",
                "size": "lg",
                "class": "w-full"
              },
              "events": {
                "blur": {
                  "action": "updateTitle"
                },
                "keyup.enter": {
                  "action": "updateTitle"
                }
              }
            },
            {
              "component": "UTextarea",
              "props": {
                "modelValue": "{{ idea.description ?? '' }}",
                "placeholder": {
                  "$type": "translation",
                  "en": "Idea description (optional)",
                  "ru": "Описание идеи (опционально)"
                },
                "rows": 6,
                "class": "w-full"
              },
              "events": {
                "blur": {
                  "action": "updateDescription"
                }
              }
            },
            {
              "component": "div",
              "props": {
                "class": "grid grid-cols-3 gap-4"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Level",
                        "ru": "Уровень"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ idea.level ?? null }}",
                        "items": "{{ levelItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:model-value": {
                          "action": "updateLevel"
                        }
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Type",
                        "ru": "Тип"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ idea.type ?? null }}",
                        "items": "{{ typeItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:model-value": {
                          "action": "updateType"
                        }
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col gap-1.5"
                  },
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "text-muted text-sm font-medium"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Status",
                        "ru": "Статус"
                      }
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ idea.status ?? 'draft' }}",
                        "items": "{{ statusItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:model-value": {
                          "action": "updateStatus"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": {
              "$type": "translation",
              "en": "Delete idea?",
              "ru": "Удалить идею?"
            },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this idea? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить эту идею? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": {
                  "variant": "ghost"
                },
                "events": {
                  "click": {
                    "action": "closeDeleteModal"
                  }
                },
                "children": {
                  "$type": "translation",
                  "en": "Cancel",
                  "ru": "Отмена"
                }
              },
              {
                "component": "UButton",
                "props": {
                  "color": "error"
                },
                "events": {
                  "click": {
                    "action": "confirmDelete"
                  }
                },
                "children": {
                  "$type": "translation",
                  "en": "Delete",
                  "ru": "Удалить"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}