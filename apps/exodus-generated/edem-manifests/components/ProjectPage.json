{
  "component": "div",
  "queries": {
    "ideas": {
      "collection": "ideas",
      "filter": {
        "project_id": {
          "_eq": "{{ route.params.id }}"
        }
      },
      "sort": [
        "-created_at"
      ]
    }
  },
  "actions": {
    "goToIdeas": {
      "steps": [
        {
          "type": "navigate",
          "to": "/project/{{ route.params.id }}/ideas"
        }
      ]
    }
  },
  "props": {
    "class": "flex h-full flex-col p-6"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
      },
      "children": [
        {
          "component": "button",
          "props": {
            "class": "border-default bg-elevated hover:bg-elevated/80 hover:border-primary flex flex-col gap-2 rounded-lg border p-5 text-left transition-colors"
          },
          "events": {
            "click": {
              "action": "goToIdeas"
            }
          },
          "children": [
            {
              "component": "div",
              "props": {
                "class": "text-muted flex items-center gap-2"
              },
              "children": [
                {
                  "component": "UIcon",
                  "props": {
                    "name": "i-lucide-lightbulb",
                    "class": "h-4 w-4"
                  }
                },
                {
                  "component": "span",
                  "props": {
                    "class": "text-sm font-medium"
                  },
                  "children": {
                    "$type": "translation",
                    "en": "Ideas",
                    "ru": "Идеи"
                  }
                }
              ]
            },
            {
              "component": "span",
              "props": {
                "class": "text-3xl font-bold"
              },
              "children": "{{ ideas.length }}"
            }
          ]
        }
      ]
    },
    {
      "component": "div",
      "if": "{{ ideas.length > 0 }}",
      "props": {
        "class": "mt-8"
      },
      "children": [
        {
          "component": "h3",
          "props": {
            "class": "text-muted mb-3 text-sm font-medium"
          },
          "children": {
            "$type": "translation",
            "en": "Recent ideas",
            "ru": "Последние идеи"
          }
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-2"
          },
          "children": [
            {
              "component": "template",
              "bind": {
                "items": "ideas.slice(0, 5)",
                "alias": "idea",
                "key": "{{ idea.id }}",
                "target": "item",
                "item": {
                  "component": "RouterLink",
                  "props": {
                    "to": "/project/{{ route.params.id }}/ideas/{{ idea.id }}",
                    "class": "border-default hover:bg-elevated flex items-center gap-3 rounded-lg border p-4 transition-colors"
                  },
                  "children": [
                    {
                      "component": "div",
                      "props": {
                        "class": "bg-primary/10 text-primary flex h-8 w-8 shrink-0 items-center justify-center rounded text-xs font-bold"
                      },
                      "children": "{{ idea.level ?? '?' }}"
                    },
                    {
                      "component": "div",
                      "props": {
                        "class": "flex flex-col"
                      },
                      "children": [
                        {
                          "component": "span",
                          "props": {
                            "class": "font-medium"
                          },
                          "children": "{{ idea.title }}"
                        },
                        {
                          "component": "span",
                          "if": "{{ idea.type }}",
                          "props": {
                            "class": "text-muted text-xs"
                          },
                          "children": "{{ idea.type }}"
                        }
                      ]
                    },
                    {
                      "component": "span",
                      "if": "{{ idea.status === 'stabilized' }}",
                      "props": {
                        "class": "ml-auto inline-flex h-5 items-center rounded bg-green-500/10 px-1.5 text-xs text-green-500"
                      },
                      "children": {
                        "$type": "translation",
                        "en": "Stabilized",
                        "ru": "Стабилизирована"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}