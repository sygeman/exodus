{
  "component": "div",
  "props": {
    "class": "scrollbar-hidden flex min-h-0 flex-1 flex-col items-center gap-2 overflow-y-auto pt-2 select-none"
  },
  "children": [
    {
      "component": "UContextMenu",
      "bind": {
        "items": "{{ projects }}",
        "item": {
          "component": "UTooltip",
          "props": {
            "text": "{{ item.name }}",
            "delay-duration": 0
          },
          "children": [
            {
              "component": "ULink",
              "props": {
                "to": "/project/{{ item.id }}/overview",
                "class": "electrobun-webkit-app-region-no-drag bg-default/50 flex h-10 w-10 flex-shrink-0 cursor-pointer items-center justify-center rounded-lg font-semibold transition-all"
              },
              "children": "{{ getInitials(item.name) }}"
            }
          ]
        }
      }
    },
    {
      "component": "UTooltip",
      "props": {
        "text": "New project",
        "delay-duration": 0
      },
      "children": [
        {
          "component": "button",
          "props": {
            "class": "electrobun-webkit-app-region-no-drag flex h-10 w-10 flex-shrink-0 cursor-pointer items-center justify-center rounded-lg text-[var(--ui-text-muted)] transition-colors hover:bg-[var(--ui-bg)] hover:text-[var(--ui-text)]"
          },
          "events": {
            "click": {
              "flow": "createProject"
            }
          },
          "children": [
            {
              "component": "UIcon",
              "props": {
                "name": "i-lucide-plus",
                "class": "h-5 w-5"
              }
            }
          ]
        }
      ]
    },
    {
      "component": "UModal",
      "modal": {
        "vModel": "deleteModalOpen",
        "title": "Delete project",
        "description": "Are you sure you want to delete this project? This action cannot be undone."
      },
      "namedSlots": {
        "footer": [
          {
            "component": "UButton",
            "props": {
              "variant": "ghost"
            },
            "events": {
              "click": {
                "flow": "togglePauseLogs"
              }
            },
            "children": "Cancel"
          },
          {
            "component": "UButton",
            "props": {
              "color": "error"
            },
            "events": {
              "click": {
                "flow": "deleteProject"
              }
            },
            "children": "Delete"
          }
        ]
      }
    }
  ]
}