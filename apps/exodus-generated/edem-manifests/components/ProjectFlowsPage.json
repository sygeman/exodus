{
  "component": "div",
  "queries": {
    "flows": {
      "collection": "flows",
      "filter": {
        "project_id": {
          "_eq": "{{ route.params.id }}"
        }
      },
      "sort": [
        "-created_at"
      ]
    }
  },
  "constants": {
    "STATUS_MAP": {
      "draft": {
        "label": "Draft",
        "class": "bg-gray-500/10 text-gray-500"
      },
      "active": {
        "label": "Active",
        "class": "bg-green-500/10 text-green-500"
      },
      "paused": {
        "label": "Paused",
        "class": "bg-yellow-500/10 text-yellow-500"
      }
    },
    "TRIGGER_LABELS": {
      "event": "Event",
      "schedule": "Schedule",
      "manual": "Manual",
      "webhook": "Webhook"
    }
  },
  "actions": {
    "handleCreate": {
      "steps": [
        {
          "type": "create-item",
          "collection": "flows",
          "assignTo": "createdId",
          "data": {
            "project_id": "{{ route.params.id }}",
            "name": "New Flow",
            "status": "draft",
            "trigger": {
              "type": "manual"
            },
            "nodes": [
              {
                "id": "{{ crypto.randomUUID() }}",
                "type": "trigger",
                "position": {
                  "x": 250,
                  "y": 50
                },
                "data": {
                  "triggerType": "manual"
                }
              }
            ],
            "edges": [],
            "meta": {
              "viewport": {
                "x": 0,
                "y": 0,
                "zoom": 1
              }
            }
          }
        },
        {
          "type": "navigate",
          "to": "/project/{{ route.params.id }}/flows/{{ createdId }}"
        }
      ]
    },
    "goToFlow": {
      "steps": [
        {
          "type": "navigate",
          "to": "/project/{{ route.params.id }}/flows/{{ item.id }}"
        }
      ]
    },
    "handleDelete": {
      "steps": [
        {
          "type": "event",
          "stopPropagation": true,
          "preventDefault": true
        },
        {
          "type": "delete-item",
          "collection": "flows",
          "id": "{{ item.id }}"
        }
      ]
    }
  },
  "props": {
    "class": "flex h-full flex-col p-6"
  },
  "children": [
    {
      "component": "div",
      "if": "{{ flowsLoading }}",
      "props": {
        "class": "flex flex-1 flex-col gap-4"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "mb-4 flex items-center justify-between"
          },
          "children": [
            {
              "component": "USkeleton",
              "props": {
                "class": "h-8 w-40"
              }
            },
            {
              "component": "USkeleton",
              "props": {
                "class": "h-9 w-32"
              }
            }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": [
              1,
              2,
              3
            ],
            "alias": "i",
            "key": "{{ i }}",
            "target": "item",
            "item": {
              "component": "div",
              "props": {
                "class": "border-default flex items-center gap-4 rounded-lg border p-4"
              },
              "children": [
                {
                  "component": "USkeleton",
                  "props": {
                    "class": "h-10 w-10 shrink-0 rounded-lg"
                  }
                },
                {
                  "component": "USkeleton",
                  "props": {
                    "class": "h-5 w-48"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !flowsLoading && flows.length === 0 }}",
      "props": {
        "class": "flex flex-1 flex-col items-center justify-center gap-4"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-workflow",
            "class": "text-muted h-12 w-12"
          }
        },
        {
          "component": "p",
          "props": {
            "class": "text-muted text-lg"
          },
          "children": {
            "$type": "translation",
            "en": "No flows yet",
            "ru": "Пока нет потоков"
          }
        },
        {
          "component": "UButton",
          "events": {
            "click": {
              "action": "handleCreate"
            }
          },
          "children": {
            "$type": "translation",
            "en": "Create flow",
            "ru": "Создать поток"
          }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": {
        "class": "flex flex-col gap-2"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "mb-4 flex items-center justify-between"
          },
          "children": [
            {
              "component": "h1",
              "props": {
                "class": "text-2xl font-bold"
              },
              "children": {
                "$type": "translation",
                "en": "Flows",
                "ru": "Потоки"
              }
            },
            {
              "component": "UButton",
              "events": {
                "click": {
                  "action": "handleCreate"
                }
              },
              "children": {
                "$type": "translation",
                "en": "Create flow",
                "ru": "Создать поток"
              }
            }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": "flows",
            "alias": "flow",
            "key": "{{ flow.id }}",
            "target": "item",
            "item": {
              "component": "button",
              "props": {
                "class": "border-default hover:bg-elevated flex items-center gap-4 rounded-lg border p-4 text-left transition-colors"
              },
              "events": {
                "click": {
                  "action": "goToFlow"
                }
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-500/10"
                  },
                  "children": [
                    {
                      "component": "UIcon",
                      "props": {
                        "name": "i-lucide-zap",
                        "class": "h-5 w-5 text-green-500"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-1 flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ flow.name }}"
                    },
                    {
                      "component": "div",
                      "props": {
                        "class": "text-muted flex items-center gap-2 text-xs"
                      },
                      "children": [
                        {
                          "component": "span",
                          "children": "{{ TRIGGER_LABELS[flow.trigger?.type || ''] || '—' }}"
                        },
                        {
                          "component": "span",
                          "children": "·"
                        },
                        {
                          "component": "span",
                          "children": "{{ Array.isArray(flow.nodes) ? flow.nodes.length : 0 }} {{ (Array.isArray(flow.nodes) ? flow.nodes.length : 0) === 1 ? 'node' : 'nodes' }}"
                        }
                      ]
                    }
                  ]
                },
                {
                  "component": "span",
                  "props": {
                    "class": "{{ `inline-flex h-5 items-center rounded px-1.5 text-xs font-medium ${STATUS_MAP[flow.status || 'draft']?.class}` }}"
                  },
                  "children": "{{ STATUS_MAP[flow.status || 'draft']?.label }}"
                },
                {
                  "component": "UButton",
                  "props": {
                    "variant": "ghost",
                    "color": "error",
                    "size": "xs",
                    "icon": "i-lucide-trash-2"
                  },
                  "events": {
                    "click": {
                      "action": "handleDelete"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}