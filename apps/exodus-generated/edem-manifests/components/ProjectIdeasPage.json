{
  "component": "div",
  "queries": {
    "ideas": {
      "collection": "ideas",
      "filter": {
        "project_id": {
          "_eq": "{{ route.params.id }}"
        }
      },
      "sort": [
        "-created_at"
      ]
    }
  },
  "flows": {
    "create": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": {
        "type": "ui-event",
        "event": "click"
      },
      "nodes": [
        {
          "id": "trigger",
          "type": "trigger",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "createIdea",
          "type": "data:create-item",
          "position": {
            "x": 220,
            "y": 0
          },
          "data": {
            "collection": "ideas",
            "assignTo": "createdId",
            "data": {
              "project_id": "{{ route.params.id }}",
              "title": "Untitled",
              "status": "draft"
            }
          }
        },
        {
          "id": "navigateToIdea",
          "type": "ui:navigate",
          "position": {
            "x": 480,
            "y": 0
          },
          "data": {
            "to": "/project/{{ route.params.id }}/ideas/{{ createdId }}"
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": {
            "x": 720,
            "y": 0
          },
          "data": {
            "value": "{{ createdId }}"
          }
        }
      ],
      "edges": [
        {
          "id": "e-project-ideas-create-1",
          "source": "trigger",
          "target": "createIdea"
        },
        {
          "id": "e-project-ideas-create-2",
          "source": "createIdea",
          "target": "navigateToIdea"
        },
        {
          "id": "e-project-ideas-create-3",
          "source": "navigateToIdea",
          "target": "output"
        }
      ]
    }
  },
  "props": {
    "class": "flex h-full flex-col p-6"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "mb-4 flex items-center justify-between"
      },
      "children": [
        {
          "component": "h2",
          "props": {
            "class": "text-lg font-semibold"
          },
          "children": {
            "$type": "translation",
            "en": "Ideas",
            "ru": "Идеи"
          }
        },
        {
          "component": "UButton",
          "props": {
            "size": "sm"
          },
          "events": {
            "click": {
              "flow": "create"
            }
          },
          "children": [
            {
              "component": "UIcon",
              "props": {
                "name": "i-lucide-plus",
                "class": "h-4 w-4"
              }
            },
            {
              "$type": "translation",
              "en": "New Idea",
              "ru": "Новая идея"
            }
          ]
        }
      ]
    },
    {
      "component": "div",
      "if": "{{ ideasLoading }}",
      "props": {
        "class": "flex flex-col gap-3"
      },
      "children": [
        {
          "component": "template",
          "bind": {
            "items": [
              1,
              2,
              3
            ],
            "alias": "i",
            "key": "{{ i }}",
            "target": "item",
            "item": {
              "component": "div",
              "props": {
                "class": "border-default flex items-center gap-3 rounded-lg border p-4"
              },
              "children": [
                {
                  "component": "USkeleton",
                  "props": {
                    "class": "h-8 w-8 shrink-0 rounded"
                  }
                },
                {
                  "component": "USkeleton",
                  "props": {
                    "class": "h-5 w-48"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !ideasLoading && ideas.length === 0 }}",
      "props": {
        "class": "text-muted flex flex-1 flex-col items-center justify-center gap-2"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-lightbulb",
            "class": "h-12 w-12 opacity-20"
          }
        },
        {
          "component": "p",
          "props": {
            "class": "text-lg"
          },
          "children": {
            "$type": "translation",
            "en": "No ideas yet",
            "ru": "Пока нет идей"
          }
        },
        {
          "component": "UButton",
          "props": {
            "size": "sm"
          },
          "events": {
            "click": {
              "flow": "create"
            }
          },
          "children": {
            "$type": "translation",
            "en": "Create first idea",
            "ru": "Создать первую идею"
          }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": {
        "class": "flex flex-col gap-2"
      },
      "children": [
        {
          "component": "template",
          "bind": {
            "items": "ideas",
            "alias": "idea",
            "key": "{{ idea.id }}",
            "target": "item",
            "item": {
              "component": "RouterLink",
              "props": {
                "to": "/project/{{ route.params.id }}/ideas/{{ idea.id }}",
                "class": "border-default hover:bg-elevated flex items-center gap-3 rounded-lg border p-4 transition-colors"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "bg-primary/10 text-primary flex h-8 w-8 shrink-0 items-center justify-center rounded text-xs font-bold"
                  },
                  "children": "{{ idea.level ?? '?' }}"
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ idea.title }}"
                    },
                    {
                      "component": "span",
                      "if": "{{ idea.type }}",
                      "props": {
                        "class": "text-muted text-xs"
                      },
                      "children": "{{ idea.type }}"
                    }
                  ]
                },
                {
                  "component": "span",
                  "if": "{{ idea.status === 'stabilized' }}",
                  "props": {
                    "class": "ml-auto inline-flex h-5 items-center rounded bg-green-500/10 px-1.5 text-xs text-green-500"
                  },
                  "children": {
                    "$type": "translation",
                    "en": "Stabilized",
                    "ru": "Стабилизирована"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}