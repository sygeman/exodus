{
  "component": "section",
  "queries": {
    "appState": {
      "kind": "singleton",
      "collection": "app_state"
    }
  },
  "actions": {
    "updateDarkMode": {
      "steps": [
        {
          "type": "update-singleton",
          "collection": "app_state",
          "data": {
            "dark": "{{ $event }}"
          }
        }
      ]
    }
  },
  "props": {
    "class": "flex flex-col gap-8"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "flex items-start justify-between gap-4"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-1"
          },
          "children": [
            {
              "component": "h3",
              "props": {
                "class": "text-base font-medium"
              },
              "children": {
                "$type": "translation",
                "en": "Dark mode",
                "ru": "Тёмная тема"
              }
            },
            {
              "component": "p",
              "props": {
                "class": "text-muted text-sm"
              },
              "children": {
                "$type": "translation",
                "en": "Use a dark color scheme.",
                "ru": "Использовать тёмную цветовую схему."
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex items-center"
          },
          "children": [
            {
              "component": "USwitch",
              "props": {
                "modelValue": "{{ !!appState?.dark }}"
              },
              "events": {
                "update:model-value": {
                  "action": "updateDarkMode"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}