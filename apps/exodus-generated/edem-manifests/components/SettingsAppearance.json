{
  "component": "section",
  "props": {
    "class": "flex flex-col gap-8"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "flex items-start justify-between gap-4"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-1"
          },
          "children": [
            {
              "component": "h3",
              "props": {
                "class": "text-base font-medium"
              },
              "children": "Dark Mode"
            },
            {
              "component": "p",
              "props": {
                "class": "text-sm text-[var(--ui-text-muted)]"
              },
              "children": "Toggle dark mode appearance"
            }
          ]
        },
        {
          "component": "USwitch",
          "props": {
            "modelValue": "{{ isDark }}"
          },
          "events": {
            "update:modelValue": {
              "flow": "toggleDarkMode"
            }
          }
        }
      ]
    }
  ]
}