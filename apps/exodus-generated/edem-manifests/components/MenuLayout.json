{
  "component": "div",
  "props": {
    "class": "flex h-full w-full"
  },
  "children": [
    {
      "component": "aside",
      "props": {
        "class": "border-default flex w-56 flex-col gap-6 border-r p-4"
      },
      "children": [
        {
          "component": "div",
          "children": [
            {
              "component": "h2",
              "props": {
                "class": "px-2 text-xl font-bold"
              },
              "children": "{{ title }}"
            }
          ]
        },
        {
          "component": "nav",
          "props": {
            "class": "flex flex-col gap-0.5"
          },
          "children": [
            {
              "component": "RouterLink",
              "props": {
                "to": "{{ item.to }}",
                "class": "text-muted hover:bg-elevated hover:text-default flex items-center gap-3 rounded-md px-2 py-1.5 text-sm font-medium transition-colors"
              },
              "bind": {
                "items": "{{ navItems }}",
                "item": {
                  "component": "span",
                  "props": {
                    "class": "flex items-center gap-3"
                  },
                  "children": [
                    {
                      "component": "UIcon",
                      "props": {
                        "name": "{{ item.icon }}",
                        "class": "h-4 w-4"
                      }
                    },
                    "{{ item.label }}"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    {
      "component": "main",
      "props": {
        "class": "w-full flex-1"
      },
      "namedSlots": {
        "default": [
          {
            "component": "RouterView"
          }
        ]
      }
    }
  ]
}
