{
  "component": "section",
  "queries": {
    "appState": {
      "kind": "singleton",
      "collection": "app_state"
    }
  },
  "computed": {
    "locales": "{{ appState.value?.locales ?? [] }}",
    "selectedLocale": "{{ appState.value?.locale }}"
  },
  "actions": {
    "updateLocale": {
      "steps": [
        {
          "type": "update-singleton",
          "collection": "app_state",
          "data": {
            "locale": "{{ item?.value }}"
          }
        }
      ]
    }
  },
  "props": {
    "class": "flex flex-col gap-8"
  },
  "children": [
    {
      "component": "div",
      "props": {
        "class": "flex flex-col gap-4"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-1"
          },
          "children": [
            {
              "component": "h3",
              "props": {
                "class": "text-base font-medium"
              },
              "children": {
                "$type": "translation",
                "en": "Language",
                "ru": "Язык"
              }
            },
            {
              "component": "p",
              "props": {
                "class": "text-muted text-sm"
              },
              "children": {
                "$type": "translation",
                "en": "Select the language you want to use in the app.",
                "ru": "Выберите язык, который хотите использовать в приложении."
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-3"
          },
          "bind": {
            "items": "locales",
            "key": "{{ l.value }}",
            "alias": "l",
            "target": "item",
            "item": {
              "component": "button",
              "props": {
                "type": "button",
                "class": "{{ { 'flex items-center gap-3 rounded-md border p-3 text-left text-sm transition-all': true, 'border-primary bg-primary/10 text-default': selectedLocale === l.value, 'text-muted border-default bg-elevated/30 hover:bg-elevated hover:border-accent': selectedLocale !== l.value } }}"
              },
              "events": {
                "click": {
                  "action": "updateLocale"
                }
              },
              "children": [
                {
                  "component": "span",
                  "props": {
                    "class": "text-2xl"
                  },
                  "children": "{{ l.flag }}"
                },
                {
                  "component": "span",
                  "props": {
                    "class": "font-medium"
                  },
                  "children": "{{ l.label }}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}