    {
      "id": "createProject",
      "name": "Create Project",
      "trigger": {
        "type": "manual"
      },
      "nodes": [
        {
          "id": "n1",
          "type": "trigger",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "n2",
          "type": "action",
          "position": {
            "x": 100,
            "y": 0
          },
          "data": {
            "module": "data",
            "proc": "createItem",
            "args": {
              "collection_id": "projects",
              "data": {
                "name": "New Project",
                "slug": "new-project",
                "type": "desktop",
                "sort_order": 0
              }
            }
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "n1",
          "target": "n2"
        }
      ]
    },
    {
      "id": "deleteProject",
      "name": "Delete Project",
      "trigger": {
        "type": "manual"
      },
      "nodes": [
        {
          "id": "n1",
          "type": "trigger",
          "position": {
            "x": 0,
            "y": 0
          },
          "data": {
            "input": {
              "projectId": "string"
            }
          }
        },
        {
          "id": "n2",
          "type": "action",
          "position": {
            "x": 100,
            "y": 0
          },
          "data": {
            "module": "data",
            "proc": "deleteItem",
            "args": {
              "item_id": "{{ trigger.projectId }}"
            }
          }
        },
        {
          "id": "n3",
          "type": "action",
          "position": {
            "x": 200,
            "y": 0
          },
          "data": {
            "module": "electrobun",
            "proc": "navigate",
            "args": {
              "path": "/projects"
            }
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "n1",
          "target": "n2"
        },
        {
          "id": "e2",
          "source": "n2",
          "target": "n3"
        }
      ]
    },
