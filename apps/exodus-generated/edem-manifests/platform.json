{
  "platform": "electrobun",
  "features": {
    "console-logger": {
      "collection": "logs",
      "dedup": true,
      "dedupWindow": 1000
    },
    "window-persistence": {
      "singleton": "app_state",
      "fields": [
        "window_frame",
        "window_maximized"
      ],
      "debounce": 300,
      "minWidth": 400,
      "minHeight": 300
    },
    "system-detection": {
      "singleton": "app_state",
      "fields": [
        "locale",
        "theme"
      ]
    },
    "updater": {
      "singleton": "updater_status",
      "checkInterval": "15m"
    },
    "devtools": {
      "accelerator": "Cmd+Option+I"
    },
    "splash": {
      "duration": 1500
    },
    "wayland-workaround": true
  }
}