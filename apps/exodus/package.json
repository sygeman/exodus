{
  "name": "exodus",
  "version": "2.2.0",
  "description": "Exodus App",
  "type": "module",
  "scripts": {
    "dev": "electrobun dev --watch",
    "dev:webview": "vite --port 5173",
    "build": "vite build",
    "build:stable": "vite build && electrobun build --env=stable",
    "icons": "./scripts/generate-icons.sh",
    "check-types": "vue-tsc --noEmit",
    "check": "bun run check-types",
    "prepare": "bun scripts/patch-electrobun.js"
  },
  "dependencies": {
    "@comark/vue": "0.4.0",
    "@exodus/edem-core": "workspace:*",
    "@exodus/edem-data": "workspace:*",
    "@exodus/edem-electrobun": "workspace:*",
    "@exodus/edem-flows": "workspace:*",
    "@exodus/edem-net": "workspace:*",
    "@exodus/edem-opencode": "workspace:*",
    "@exodus/edem-tts": "workspace:*",
    "@exodus/edem-vue": "workspace:*",
    "@exodus/typescript-config": "workspace:*",
    "@nuxt/ui": "4.7.1",
    "@types/sortablejs": "1.15.9",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vueuse/core": "14.3.0",
    "@vueuse/integrations": "14.3.0",
    "electrobun": "1.18.1",
    "marked": "18.0.5",
    "sortablejs": "1.15.7",
    "tailwindcss": "4.3.0",
    "vue-i18n": "11.4.4",
    "vue-router": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vite-svg-loader": "5.1.1",
    "vue": "3.5.35",
    "vue-tsc": "3.3.3"
  }
}
