{
  "component": "div",
  "queries": {
    "data": {
      "collection": "projects"
    }
  },
  "flows": {
    "create": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "createProject",
          "type": "data:create-item",
          "position": { "x": 220, "y": 0 },
          "data": {
            "collection": "projects",
            "assignTo": "createdId",
            "data": {
              "name": "Untitled",
              "slug": "{{ `untitled-${crypto.randomUUID().slice(0, 8)}` }}",
              "type": "desktop",
              "sort_order": 0
            }
          }
        },
        {
          "id": "navigateToProject",
          "type": "ui:navigate",
          "position": { "x": 480, "y": 0 },
          "data": { "to": "/project/{{ createdId }}/overview" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 720, "y": 0 },
          "data": { "value": "{{ createdId }}" }
        }
      ],
      "edges": [
        { "id": "e-projects-create-1", "source": "trigger", "target": "createProject" },
        { "id": "e-projects-create-2", "source": "createProject", "target": "navigateToProject" },
        { "id": "e-projects-create-3", "source": "navigateToProject", "target": "output" }
      ]
    }
  },
  "props": { "class": "flex h-full flex-col p-8" },
  "children": [
    {
      "component": "div",
      "if": "{{ dataLoading }}",
      "props": { "class": "flex flex-1 flex-col gap-4" },
      "children": [
        {
          "component": "div",
          "props": { "class": "mb-4 flex items-center justify-between" },
          "children": [
            { "component": "USkeleton", "props": { "class": "h-8 w-40" } },
            { "component": "USkeleton", "props": { "class": "h-9 w-32" } }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": [1, 2, 3, 4, 5],
            "alias": "i",
            "key": "{{ i }}",
            "target": "item",
            "item": {
              "component": "div",
              "props": { "class": "border-default flex items-center gap-4 rounded-lg border p-4" },
              "children": [
                { "component": "USkeleton", "props": { "class": "h-10 w-10 shrink-0 rounded-lg" } },
                { "component": "USkeleton", "props": { "class": "h-5 w-48" } }
              ]
            }
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !dataLoading && data.length === 0 }}",
      "props": { "class": "flex flex-1 flex-col items-center justify-center gap-4" },
      "children": [
        {
          "component": "UIcon",
          "props": { "name": "i-lucide-folder-open", "class": "text-muted h-12 w-12" }
        },
        {
          "component": "p",
          "props": { "class": "text-muted text-lg" },
          "children": { "$type": "translation", "en": "No projects yet", "ru": "Пока нет проектов" }
        },
        {
          "component": "UButton",
          "events": { "click": { "flow": "create" } },
          "children": { "$type": "translation", "en": "Create project", "ru": "Создать проект" }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "flex flex-col gap-2" },
      "children": [
        {
          "component": "div",
          "props": { "class": "mb-4 flex items-center justify-between" },
          "children": [
            {
              "component": "h1",
              "props": { "class": "text-2xl font-bold" },
              "children": { "$type": "translation", "en": "Projects", "ru": "Проекты" }
            },
            {
              "component": "UButton",
              "events": { "click": { "flow": "create" } },
              "children": { "$type": "translation", "en": "Create project", "ru": "Создать проект" }
            }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": "data",
            "alias": "project",
            "key": "{{ project.id }}",
            "target": "item",
            "item": {
              "component": "RouterLink",
              "props": {
                "to": "/project/{{ project.id }}/overview",
                "class": "hover:border-primary border-default flex items-center gap-4 rounded-lg border p-4 transition-colors"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "bg-elevated flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border-2 border-transparent font-semibold transition-colors"
                  },
                  "children": "{{ getInitials(project.name) }}"
                },
                {
                  "component": "span",
                  "props": { "class": "font-medium" },
                  "children": "{{ project.name }}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
