{
  "component": "div",
  "queries": {
    "flows": {
      "collection": "project_flows",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      }
    }
  },
  "state": {
    "deleteModalOpen": false
  },
  "constants": {
    "navItems": [
      {
        "to": "/project/{{ route.params.id }}/flows/{{ route.params.flowId }}/settings",
        "label": { "$type": "translation", "en": "General", "ru": "Общие" },
        "icon": "i-lucide-settings"
      }
    ],
    "statusItems": [
      { "label": "draft", "value": "draft" },
      { "label": "active", "value": "active" },
      { "label": "paused", "value": "paused" },
      { "label": "archived", "value": "archived" }
    ]
  },
  "computed": {
    "flow": "{{ flows.value.find((entry) => entry.id === route.params.flowId) ?? null }}"
  },
  "actions": {
    "updateName": {
      "steps": [
        { "type": "guard", "condition": "{{ flow.value }}" },
        { "type": "guard", "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() !== '' }}" },
        { "type": "guard", "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() !== flow.value.name }}" },
        {
          "type": "update-item",
          "collection": "project_flows",
          "id": "{{ flow.value.id }}",
          "data": {
            "name": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() }}"
          }
        }
      ]
    },
    "updateStatus": {
      "steps": [
        { "type": "guard", "condition": "{{ flow.value }}" },
        { "type": "guard", "condition": "{{ $event !== flow.value.status }}" },
        {
          "type": "update-item",
          "collection": "project_flows",
          "id": "{{ flow.value.id }}",
          "data": {
            "status": "{{ $event }}"
          }
        }
      ]
    },
    "openDeleteModal": {
      "steps": [
        { "type": "set-state", "state": "deleteModalOpen", "value": true }
      ]
    },
    "closeDeleteModal": {
      "steps": [
        { "type": "set-state", "state": "deleteModalOpen", "value": false }
      ]
    },
    "confirmDelete": {
      "steps": [
        { "type": "guard", "condition": "{{ flow.value }}" },
        { "type": "delete-item", "collection": "project_flows", "id": "{{ flow.value.id }}" },
        { "type": "set-state", "state": "deleteModalOpen", "value": false },
        { "type": "navigate", "to": "/project/{{ route.params.id }}/flows" }
      ]
    }
  },
  "props": { "class": "flex h-full" },
  "children": [
    {
      "component": "SettingsLayout",
      "if": "{{ flow }}",
      "props": {
        "title": { "$type": "translation", "en": "Settings", "ru": "Настройки" },
        "items": "{{ navItems }}",
        "pageTitle": { "$type": "translation", "en": "Flow Settings", "ru": "Настройки флоу" }
      },
      "children": [
        {
          "component": "section",
          "props": { "class": "flex flex-col gap-8" },
          "children": [
            {
              "component": "div",
              "props": { "class": "border-default flex flex-col gap-4 border-b pb-8" },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1" },
                  "children": [
                    {
                      "component": "h3",
                      "props": { "class": "text-base font-medium" },
                      "children": { "$type": "translation", "en": "Name", "ru": "Название" }
                    },
                    {
                      "component": "p",
                      "props": { "class": "text-muted text-sm" },
                      "children": { "$type": "translation", "en": "Flow name is displayed in the list and sidebar.", "ru": "Название флоу отображается в списке и боковом меню." }
                    }
                  ]
                },
                {
                  "component": "UInput",
                  "props": { "class": "max-w-md", "modelValue": "{{ flow.name ?? '' }}" },
                  "events": {
                    "blur": { "action": "updateName" },
                    "keyup.enter": { "action": "updateName" }
                  }
                }
              ]
            },
            {
              "component": "div",
              "props": { "class": "border-default flex flex-col gap-4 border-b pb-8" },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1" },
                  "children": [
                    {
                      "component": "h3",
                      "props": { "class": "text-base font-medium" },
                      "children": { "$type": "translation", "en": "Status", "ru": "Статус" }
                    },
                    {
                      "component": "p",
                      "props": { "class": "text-muted text-sm" },
                      "children": { "$type": "translation", "en": "Flow status determines whether it is running or paused.", "ru": "Статус флоу определяет, запущен он или приостановлен." }
                    }
                  ]
                },
                {
                  "component": "USelect",
                  "props": {
                      "modelValue": "{{ flow.status ?? 'draft' }}",
                    "items": "{{ statusItems }}",
                    "valueKey": "value",
                    "labelKey": "label",
                    "size": "sm",
                    "class": "max-w-md"
                  },
                  "events": { "update:model-value": { "action": "updateStatus" } }
                }
              ]
            },
            {
              "component": "div",
              "children": [
                {
                  "component": "h3",
                  "props": { "class": "text-error mb-2 text-base font-medium" },
                  "children": { "$type": "translation", "en": "Delete flow", "ru": "Удаление флоу" }
                },
                {
                  "component": "p",
                  "props": { "class": "text-muted mb-4 text-sm" },
                  "children": { "$type": "translation", "en": "This action cannot be undone. All flow data will be permanently deleted.", "ru": "Это действие нельзя отменить. Все данные флоу будут безвозвратно удалены." }
                },
                {
                  "component": "UButton",
                  "props": { "color": "error", "variant": "outline" },
                  "events": { "click": { "action": "openDeleteModal" } },
                  "children": [
                    { "component": "UIcon", "props": { "name": "i-lucide-trash-2", "class": "h-4 w-4" } },
                    { "component": "span", "props": { "class": "ml-2" }, "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": { "$type": "translation", "en": "Delete flow?", "ru": "Удалить флоу?" },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this flow? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить этот флоу? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": { "variant": "ghost" },
                "events": { "click": { "action": "closeDeleteModal" } },
                "children": { "$type": "translation", "en": "Cancel", "ru": "Отмена" }
              },
              {
                "component": "UButton",
                "props": { "color": "error" },
                "events": { "click": { "action": "confirmDelete" } },
                "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
              }
            ]
          }
        }
      ]
    }
  ]
}
