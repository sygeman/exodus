{
  "component": "div",
  "queries": {
    "flows": {
      "collection": "flows",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      },
      "sort": ["-created_at"]
    }
  },
  "constants": {
    "STATUS_MAP": {
      "draft": { "label": "Draft", "class": "bg-gray-500/10 text-gray-500" },
      "active": { "label": "Active", "class": "bg-green-500/10 text-green-500" },
      "paused": { "label": "Paused", "class": "bg-yellow-500/10 text-yellow-500" }
    },
    "TRIGGER_LABELS": {
      "event": "Event",
      "schedule": "Schedule",
      "manual": "Manual"
    }
  },
  "flows": {
    "create": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "createFlow",
          "type": "data:create-item",
          "position": { "x": 220, "y": 0 },
          "data": {
            "collection": "flows",
            "assignTo": "createdId",
            "data": {
              "project_id": "{{ route.params.id }}",
              "name": "New Flow",
              "status": "draft",
              "trigger": { "type": "manual" },
              "nodes": [
                {
                  "id": "{{ crypto.randomUUID() }}",
                  "type": "trigger",
                  "position": { "x": 250, "y": 50 },
                  "data": { "triggerType": "manual" }
                }
              ],
              "edges": [],
              "meta": { "viewport": { "x": 0, "y": 0, "zoom": 1 } }
            }
          }
        },
        {
          "id": "navigateToFlow",
          "type": "ui:navigate",
          "position": { "x": 480, "y": 0 },
          "data": { "to": "/project/{{ route.params.id }}/flows/{{ createdId }}" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 720, "y": 0 },
          "data": { "value": "{{ createdId }}" }
        }
      ],
      "edges": [
        { "id": "e-project-flows-create-1", "source": "trigger", "target": "createFlow" },
        { "id": "e-project-flows-create-2", "source": "createFlow", "target": "navigateToFlow" },
        { "id": "e-project-flows-create-3", "source": "navigateToFlow", "target": "output" }
      ]
    },
    "goToFlow": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "navigateToFlow",
          "type": "ui:navigate",
          "position": { "x": 220, "y": 0 },
          "data": { "to": "/project/{{ route.params.id }}/flows/{{ trigger.item.id }}/graph" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 440, "y": 0 },
          "data": { "value": "{{ trigger.item.id }}" }
        }
      ],
      "edges": [
        { "id": "e-project-flows-open-1", "source": "trigger", "target": "navigateToFlow" },
        { "id": "e-project-flows-open-2", "source": "navigateToFlow", "target": "output" }
      ]
    },
    "delete": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "stopEvent",
          "type": "ui:event",
          "position": { "x": 180, "y": 0 },
          "data": { "stopPropagation": true, "preventDefault": true }
        },
        {
          "id": "deleteFlow",
          "type": "data:delete-item",
          "position": { "x": 380, "y": 0 },
          "data": { "collection": "flows", "id": "{{ trigger.item.id }}" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 580, "y": 0 },
          "data": { "value": "{{ trigger.item.id }}" }
        }
      ],
      "edges": [
        { "id": "e-project-flows-delete-1", "source": "trigger", "target": "stopEvent" },
        { "id": "e-project-flows-delete-2", "source": "stopEvent", "target": "deleteFlow" },
        { "id": "e-project-flows-delete-3", "source": "deleteFlow", "target": "output" }
      ]
    }
  },
  "props": { "class": "flex h-full flex-col p-6" },
  "children": [
    {
      "component": "div",
      "if": "{{ flowsLoading }}",
      "props": { "class": "flex flex-1 flex-col gap-4" },
      "children": [
        {
          "component": "div",
          "props": { "class": "mb-4 flex items-center justify-between" },
          "children": [
            { "component": "USkeleton", "props": { "class": "h-8 w-40" } },
            { "component": "USkeleton", "props": { "class": "h-9 w-32" } }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": [1, 2, 3],
            "alias": "i",
            "key": "{{ i }}",
            "target": "item",
            "item": {
              "component": "div",
              "props": { "class": "border-default flex items-center gap-4 rounded-lg border p-4" },
              "children": [
                { "component": "USkeleton", "props": { "class": "h-10 w-10 shrink-0 rounded-lg" } },
                { "component": "USkeleton", "props": { "class": "h-5 w-48" } }
              ]
            }
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !flowsLoading && flows.length === 0 }}",
      "props": { "class": "flex flex-1 flex-col items-center justify-center gap-4" },
      "children": [
        { "component": "UIcon", "props": { "name": "i-lucide-workflow", "class": "text-muted h-12 w-12" } },
        { "component": "p", "props": { "class": "text-muted text-lg" }, "children": { "$type": "translation", "en": "No flows yet", "ru": "Пока нет потоков" } },
        {
          "component": "UButton",
          "events": { "click": { "flow": "create" } },
          "children": { "$type": "translation", "en": "Create flow", "ru": "Создать поток" }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "flex flex-col gap-2" },
      "children": [
        {
          "component": "div",
          "props": { "class": "mb-4 flex items-center justify-between" },
          "children": [
            {
              "component": "h1",
              "props": { "class": "text-2xl font-bold" },
              "children": { "$type": "translation", "en": "Flows", "ru": "Потоки" }
            },
            {
              "component": "UButton",
               "events": { "click": { "flow": "create" } },
              "children": { "$type": "translation", "en": "Create flow", "ru": "Создать поток" }
            }
          ]
        },
        {
          "component": "template",
          "bind": {
            "items": "flows",
            "alias": "flow",
            "key": "{{ flow.id }}",
            "target": "item",
            "item": {
              "component": "button",
              "props": {
                "class": "border-default hover:bg-elevated flex items-center gap-4 rounded-lg border p-4 text-left transition-colors"
              },
              "events": { "click": { "flow": "goToFlow" } },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-500/10" },
                  "children": [
                    { "component": "UIcon", "props": { "name": "i-lucide-zap", "class": "h-5 w-5 text-green-500" } }
                  ]
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-1 flex-col" },
                  "children": [
                    { "component": "span", "props": { "class": "font-medium" }, "children": "{{ flow.name }}" },
                    {
                      "component": "div",
                      "props": { "class": "text-muted flex items-center gap-2 text-xs" },
                      "children": [
                        { "component": "span", "children": "{{ TRIGGER_LABELS[flow.trigger?.type || ''] || '—' }}" },
                        { "component": "span", "children": "·" },
                        { "component": "span", "children": "{{ Array.isArray(flow.nodes) ? flow.nodes.length : 0 }} {{ (Array.isArray(flow.nodes) ? flow.nodes.length : 0) === 1 ? 'node' : 'nodes' }}" }
                      ]
                    }
                  ]
                },
                {
                  "component": "span",
                  "props": {
                    "class": "{{ `inline-flex h-5 items-center rounded px-1.5 text-xs font-medium ${STATUS_MAP[flow.status || 'draft']?.class}` }}"
                  },
                  "children": "{{ STATUS_MAP[flow.status || 'draft']?.label }}"
                },
                {
                  "component": "UButton",
                  "props": { "variant": "ghost", "color": "error", "size": "xs", "icon": "i-lucide-trash-2" },
                  "events": { "click": { "flow": "delete" } }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
