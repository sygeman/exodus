{
  "component": "MenuLayout",
  "props": {
    "title": "{{ props.title }}",
    "items": "{{ props.items }}",
    "mainClass": "overflow-y-auto p-10"
  },
  "children": [
    {
      "component": "div",
      "props": { "class": "w-full" },
      "children": [
        {
          "component": "h1",
          "props": { "class": "mb-8 text-2xl font-bold" },
          "children": "{{ props.pageTitle }}"
        },
        {
          "component": "slot"
        }
      ]
    }
  ],
  "rawScript": "interface MenuLayoutItem {\n  to: string\n  label: string\n  icon: string\n}\n\nconst props = defineProps<{\n  title: string\n  items: MenuLayoutItem[]\n  pageTitle: string\n}>()"
}
