{
  "component": "div",
  "queries": {
    "projects": {
      "collection": "projects"
    }
  },
  "state": {
    "deleteModalOpen": false
  },
  "constants": {
    "navItems": [
      {
        "to": "/project/{{ route.params.id }}/settings",
        "label": { "$type": "translation", "en": "General", "ru": "Общие" },
        "icon": "i-lucide-settings"
      }
    ]
  },
  "computed": {
    "project": "{{ projects.value.find((p) => p.id === route.params.id) ?? null }}",
    "loading": "{{ projectsLoading.value }}"
  },
  "actions": {
    "updateName": {
      "steps": [
        { "type": "guard", "condition": "{{ project.value }}" },
        { "type": "guard", "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value).trim() !== '' }}" },
        { "type": "guard", "condition": "{{ (((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value) !== project.value.name }}" },
        {
          "type": "update-item",
          "collection": "projects",
          "id": "{{ project.value.id }}",
          "data": {
            "name": "{{ ((($event as FocusEvent | KeyboardEvent).target) as HTMLInputElement).value }}"
          }
        }
      ]
    },
    "openDeleteModal": {
      "steps": [
        { "type": "set-state", "state": "deleteModalOpen", "value": true }
      ]
    },
    "closeDeleteModal": {
      "steps": [
        { "type": "set-state", "state": "deleteModalOpen", "value": false }
      ]
    },
    "confirmDelete": {
      "steps": [
        { "type": "guard", "condition": "{{ project.value }}" },
        { "type": "delete-item", "collection": "projects", "id": "{{ project.value.id }}" },
        { "type": "set-state", "state": "deleteModalOpen", "value": false },
        { "type": "navigate", "to": "/projects" }
      ]
    }
  },
  "props": { "class": "flex h-full" },
  "children": [
    {
      "component": "SettingsLayout",
        "if": "{{ project }}",
      "props": {
        "title": { "$type": "translation", "en": "Settings", "ru": "Настройки" },
        "items": "{{ navItems }}",
        "pageTitle": { "$type": "translation", "en": "Project Settings", "ru": "Настройки проекта" }
      },
      "children": [
        {
          "component": "section",
          "props": { "class": "flex flex-col gap-8" },
          "children": [
            {
              "component": "div",
              "props": { "class": "border-default flex flex-col gap-4 border-b pb-8" },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1" },
                  "children": [
                    {
                      "component": "h3",
                      "props": { "class": "text-base font-medium" },
                      "children": { "$type": "translation", "en": "Name", "ru": "Название" }
                    },
                    {
                      "component": "p",
                      "props": { "class": "text-muted text-sm" },
                      "children": {
                        "$type": "translation",
                        "en": "Project name is displayed in the list and sidebar.",
                        "ru": "Название проекта отображается в списке и боковом меню."
                      }
                    }
                  ]
                },
                {
                  "component": "UInput",
                  "props": { "class": "max-w-md", "modelValue": "{{ project.name ?? '' }}" },
                  "events": {
                    "blur": { "action": "updateName" },
                    "keyup.enter": { "action": "updateName" }
                  }
                }
              ]
            },
            {
              "component": "div",
              "children": [
                {
                  "component": "h3",
                  "props": { "class": "text-error mb-2 text-base font-medium" },
                  "children": { "$type": "translation", "en": "Delete project", "ru": "Удаление проекта" }
                },
                {
                  "component": "p",
                  "props": { "class": "text-muted mb-4 text-sm" },
                  "children": {
                    "$type": "translation",
                    "en": "This action cannot be undone. All project data will be permanently deleted.",
                    "ru": "Это действие нельзя отменить. Все данные проекта будут безвозвратно удалены."
                  }
                },
                {
                  "component": "UButton",
                  "props": { "color": "error", "variant": "outline" },
                  "events": { "click": { "action": "openDeleteModal" } },
                  "children": [
                    { "component": "UIcon", "props": { "name": "i-lucide-trash-2", "class": "h-4 w-4" } },
                    {
                      "component": "span",
                      "props": { "class": "ml-2" },
                      "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": { "$type": "translation", "en": "Delete project?", "ru": "Удалить проект?" },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this project? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить этот проект? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": { "variant": "ghost" },
                "events": { "click": { "action": "closeDeleteModal" } },
                "children": { "$type": "translation", "en": "Cancel", "ru": "Отмена" }
              },
              {
                "component": "UButton",
                "props": { "color": "error" },
                "events": { "click": { "action": "confirmDelete" } },
                "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
              }
            ]
          }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !loading }}",
      "props": { "class": "text-muted flex h-full flex-col items-center justify-center gap-2" },
      "children": [
        { "component": "UIcon", "props": { "name": "i-lucide-folder-x", "class": "h-10 w-10" } },
        {
          "component": "p",
          "children": { "$type": "translation", "en": "Project not found", "ru": "Проект не найден" }
        },
        {
          "component": "UButton",
          "props": { "to": "/projects", "variant": "link" },
          "children": { "$type": "translation", "en": "Back to projects", "ru": "Назад к проектам" }
        }
      ]
    }
  ]
}
