{
  "component": "div",
  "queries": {
    "flows": {
      "collection": "flows",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      }
    }
  },
  "state": {
    "copied": false
  },
  "flows": {
    "copyToClipboard": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardManifest",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "manifest" }
        },
        {
          "id": "copy",
          "type": "ui:clipboard-write",
          "position": { "x": 360, "y": 0 },
          "data": { "text": "{{ manifest }}" }
        },
        {
          "id": "setCopied",
          "type": "ui:set-state",
          "position": { "x": 540, "y": 0 },
          "data": { "state": "copied", "value": true }
        },
        {
          "id": "resetCopied",
          "type": "ui:set-timeout-state",
          "position": { "x": 720, "y": 0 },
          "data": { "state": "copied", "value": false, "delay": 2000 }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 900, "y": 0 },
          "data": { "value": "{{ manifest }}" }
        }
      ],
      "edges": [
        { "id": "e1", "source": "trigger", "target": "guardManifest" },
        { "id": "e2", "source": "guardManifest", "sourceHandle": "true", "target": "copy" },
        { "id": "e3", "source": "copy", "target": "setCopied" },
        { "id": "e4", "source": "setCopied", "target": "resetCopied" },
        { "id": "e5", "source": "resetCopied", "target": "output" }
      ]
    }
  },
  "computed": {
    "loading": "{{ flowsLoading }}",
    "flow": "{{ flows.find((entry) => entry.id === route.params.flowId) ?? null }}",
    "manifest": "{{ flow ? JSON.stringify(flow.data, null, 2) : '' }}"
  },
  "props": { "class": "flex min-h-0 flex-1 flex-col" },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": { "class": "flex flex-1 items-center justify-center" },
      "children": [
        { "component": "USkeleton", "props": { "class": "h-64 w-96 rounded-lg" } }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !loading && !flow }}",
      "props": { "class": "text-muted flex flex-1 items-center justify-center text-sm" },
      "children": { "$type": "translation", "en": "Flow not found", "ru": "Поток не найден" }
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "relative flex flex-1 overflow-hidden" },
      "children": [
        {
          "component": "pre",
          "props": { "class": "flex-1 overflow-auto p-4 font-mono text-xs leading-relaxed" },
          "children": "{{ manifest }}"
        },
        {
          "component": "UTooltip",
          "props": {
            "text": "{{ copied ? t({ en: 'Copied!', ru: 'Скопировано!' }) : t({ en: 'Copy', ru: 'Копировать' }) }}"
          },
          "children": [
            {
              "component": "UButton",
              "props": {
                "variant": "outline",
                "size": "xs",
                "icon": "{{ copied ? 'i-lucide-check' : 'i-lucide-copy' }}",
                "class": "absolute top-3 right-3"
              },
              "events": { "click": { "flow": "copyToClipboard" } }
            }
          ]
        }
      ]
    }
  ]
}
