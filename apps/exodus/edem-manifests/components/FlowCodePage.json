{
  "component": "div",
  "queries": {
    "flows": {
      "collection": "flows",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      }
    }
  },
  "state": {
    "copied": false
  },
  "computed": {
    "loading": "{{ flowsLoading }}",
    "flow": "{{ flows.find((entry) => entry.id === route.params.flowId) ?? null }}",
    "manifest": "{{ flow ? JSON.stringify(flow.data, null, 2) : '' }}"
  },
  "props": { "class": "flex min-h-0 flex-1 flex-col" },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": { "class": "flex flex-1 items-center justify-center" },
      "children": [
        { "component": "USkeleton", "props": { "class": "h-64 w-96 rounded-lg" } }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !loading && !flow }}",
      "props": { "class": "text-muted flex flex-1 items-center justify-center text-sm" },
      "children": { "$type": "translation", "en": "Flow not found", "ru": "Поток не найден" }
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "relative flex flex-1 overflow-hidden" },
      "children": [
        {
          "component": "pre",
          "props": { "class": "flex-1 overflow-auto p-4 font-mono text-xs leading-relaxed" },
          "children": "{{ manifest }}"
        },
        {
          "component": "UTooltip",
          "props": {
            "text": "{{ copied ? t({ en: 'Copied!', ru: 'Скопировано!' }) : t({ en: 'Copy', ru: 'Копировать' }) }}"
          },
          "children": [
            {
              "component": "UButton",
              "props": {
                "variant": "outline",
                "size": "xs",
                "icon": "{{ copied ? 'i-lucide-check' : 'i-lucide-copy' }}",
                "class": "absolute top-3 right-3"
              },
              "events": { "click": { "flow": "flowCode.copyToClipboard" } }
            }
          ]
        }
      ]
    }
  ]
}
