{
  "component": "div",
  "queries": {
    "ideas": {
      "collection": "ideas",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      }
    }
  },
  "state": {
    "deleteModalOpen": false
  },
  "constants": {
    "levelItems": [
      { "label": "L1", "value": "L1" },
      { "label": "L2", "value": "L2" },
      { "label": "L3", "value": "L3" },
      { "label": "L4", "value": "L4" }
    ],
    "typeItems": [
      { "label": "goal", "value": "goal" },
      { "label": "non_goal", "value": "non_goal" },
      { "label": "constraint", "value": "constraint" },
      { "label": "invariant", "value": "invariant" },
      { "label": "component", "value": "component" },
      { "label": "decision", "value": "decision" },
      { "label": "principle", "value": "principle" }
    ],
    "statusItems": [
      { "label": "draft", "value": "draft" },
      { "label": "stabilized", "value": "stabilized" }
    ]
  },
  "computed": {
    "idea": "{{ ideas.find((entry) => entry.id === route.params.ideaId) ?? null }}",
    "loading": "{{ ideasLoading }}",
    "backLink": "{{ `/project/${route.params.id}/ideas` }}"
  },
  "props": { "class": "flex h-full flex-col" },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": { "class": "flex h-full items-center justify-center" },
      "children": [
        {
          "component": "UIcon",
          "props": { "name": "i-lucide-loader-2", "class": "text-muted h-8 w-8 animate-spin" }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !idea }}",
      "props": { "class": "text-muted flex h-full flex-col items-center justify-center gap-2" },
      "children": [
        {
          "component": "UIcon",
          "props": { "name": "i-lucide-file-x", "class": "h-12 w-12 opacity-20" }
        },
        {
          "component": "p",
          "children": { "$type": "translation", "en": "Idea not found", "ru": "Идея не найдена" }
        },
        {
          "component": "UButton",
          "props": { "to": "{{ backLink }}", "variant": "link" },
          "children": { "$type": "translation", "en": "Back to ideas", "ru": "Назад к идеям" }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "flex flex-1 flex-col gap-6 overflow-y-auto" },
      "children": [
        {
          "component": "div",
          "props": { "class": "border-default flex items-center justify-between border-b px-6 py-3" },
          "children": [
            {
              "component": "div",
              "props": { "class": "flex items-center gap-3" },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "to": "{{ backLink }}",
                    "variant": "ghost",
                    "size": "sm",
                    "icon": "i-lucide-arrow-left"
                  },
                  "children": { "$type": "translation", "en": "Back to ideas", "ru": "Назад к идеям" }
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-wrap items-center gap-2" },
                  "children": [
                    {
                      "component": "UBadge",
                      "props": {
                        "label": "{{ idea.level || t({ en: 'No level', ru: 'Без уровня' }) }}",
                        "color": "neutral",
                        "variant": "subtle",
                        "class": "bg-primary/10 text-primary text-xs font-semibold"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.type }}",
                      "props": {
                        "label": "{{ idea.type }}",
                        "color": "neutral",
                        "variant": "soft",
                        "size": "sm"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.status === 'stabilized' }}",
                      "props": {
                        "label": { "$type": "translation", "en": "Stabilized", "ru": "Стабилизирована" },
                        "color": "success",
                        "variant": "subtle",
                        "size": "sm"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "component": "UButton",
              "props": {
                "color": "error",
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-trash-2"
              },
              "events": { "click": { "flow": "idea.openDeleteModal" } },
              "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
            }
          ]
        },
        {
          "component": "div",
          "props": { "class": "flex flex-col gap-6 px-6 pb-6" },
          "children": [
            {
              "component": "UInput",
              "props": { "size": "lg", "class": "w-full" },
              "model": { "value": "{{ idea.title ?? '' }}" },
              "events": {
                "blur": { "flow": "idea.updateTitle" },
                "keyup.enter": { "flow": "idea.updateTitle" }
              }
            },
            {
              "component": "UTextarea",
              "model": { "value": "{{ idea.description ?? '' }}" },
              "props": {
                "placeholder": {
                  "$type": "translation",
                  "en": "Idea description (optional)",
                  "ru": "Описание идеи (опционально)"
                },
                "rows": 6,
                "class": "w-full"
              },
              "events": { "blur": { "flow": "idea.updateDescription" } }
            },
            {
              "component": "div",
              "props": { "class": "grid grid-cols-3 gap-4" },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Level", "ru": "Уровень" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.level ?? null }}",
                        "onChange": { "flow": "idea.updateLevel" }
                      },
                      "props": {
                        "items": "{{ levelItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Type", "ru": "Тип" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.type ?? null }}",
                        "onChange": { "flow": "idea.updateType" }
                      },
                      "props": {
                        "items": "{{ typeItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Status", "ru": "Статус" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.status ?? 'draft' }}",
                        "onChange": { "flow": "idea.updateStatus" }
                      },
                      "props": {
                        "items": "{{ statusItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": { "$type": "translation", "en": "Delete idea?", "ru": "Удалить идею?" },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this idea? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить эту идею? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": { "variant": "ghost" },
                "events": { "click": { "flow": "idea.closeDeleteModal" } },
                "children": { "$type": "translation", "en": "Cancel", "ru": "Отмена" }
              },
              {
                "component": "UButton",
                "props": { "color": "error" },
                "events": { "click": { "flow": "idea.confirmDelete" } },
                "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
              }
            ]
          }
        }
      ]
    }
  ]
}
