{
  "component": "div",
  "queries": {
    "ideas": {
      "collection": "ideas",
      "filter": {
        "project_id": { "_eq": "{{ route.params.id }}" }
      }
    }
  },
  "state": {
    "deleteModalOpen": false
  },
  "flows": {
    "openDeleteModal": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "openModal",
          "type": "ui:set-state",
          "position": { "x": 200, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": true }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 400, "y": 0 },
          "data": { "value": true }
        }
      ],
      "edges": [
        { "id": "e-idea-open-1", "source": "trigger", "target": "openModal" },
        { "id": "e-idea-open-2", "source": "openModal", "target": "output" }
      ]
    },
    "closeDeleteModal": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "closeModal",
          "type": "ui:set-state",
          "position": { "x": 200, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": false }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 400, "y": 0 },
          "data": { "value": false }
        }
      ],
      "edges": [
        { "id": "e-idea-close-1", "source": "trigger", "target": "closeModal" },
        { "id": "e-idea-close-2", "source": "closeModal", "target": "output" }
      ]
    },
    "confirmDelete": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "click" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "deleteIdea",
          "type": "data:delete-item",
          "position": { "x": 360, "y": 0 },
          "data": { "collection": "ideas", "id": "{{ idea.id }}" }
        },
        {
          "id": "closeModal",
          "type": "ui:set-state",
          "position": { "x": 560, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": false }
        },
        {
          "id": "navigateBack",
          "type": "ui:navigate",
          "position": { "x": 760, "y": 0 },
          "data": { "to": "{{ backLink }}" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 960, "y": 0 },
          "data": { "value": "{{ backLink }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-delete-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-delete-2", "source": "guardIdea", "sourceHandle": "true", "target": "deleteIdea" },
        { "id": "e-idea-delete-3", "source": "deleteIdea", "target": "closeModal" },
        { "id": "e-idea-delete-4", "source": "closeModal", "target": "navigateBack" },
        { "id": "e-idea-delete-5", "source": "navigateBack", "target": "output" }
      ]
    },
    "updateTitle": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "blur" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardNotEmpty",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": { "condition": "String(trigger.event?.target?.value ?? '').trim() !== ''" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 560, "y": 0 },
          "data": { "condition": "String(trigger.event?.target?.value ?? '').trim() !== (idea.title ?? '')" }
        },
        {
          "id": "updateTitle",
          "type": "data:update-item",
          "position": { "x": 780, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": {
              "title": "{{ String(trigger.event?.target?.value ?? '').trim() }}"
            }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 1000, "y": 0 },
          "data": { "value": "{{ String(trigger.event?.target?.value ?? '').trim() }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-title-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-title-2", "source": "guardIdea", "sourceHandle": "true", "target": "guardNotEmpty" },
        { "id": "e-idea-title-3", "source": "guardNotEmpty", "sourceHandle": "true", "target": "guardChanged" },
        { "id": "e-idea-title-4", "source": "guardChanged", "sourceHandle": "true", "target": "updateTitle" },
        { "id": "e-idea-title-5", "source": "updateTitle", "target": "output" }
      ]
    },
    "updateDescription": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "blur" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": { "condition": "String(trigger.event?.target?.value ?? '') !== (idea.description ?? '')" }
        },
        {
          "id": "updateDescription",
          "type": "data:update-item",
          "position": { "x": 580, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": {
              "description": "{{ String(trigger.event?.target?.value ?? '') || null }}"
            }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 800, "y": 0 },
          "data": { "value": "{{ String(trigger.event?.target?.value ?? '') || null }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-desc-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-desc-2", "source": "guardIdea", "sourceHandle": "true", "target": "guardChanged" },
        { "id": "e-idea-desc-3", "source": "guardChanged", "sourceHandle": "true", "target": "updateDescription" },
        { "id": "e-idea-desc-4", "source": "updateDescription", "target": "output" }
      ]
    },
    "updateLevel": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "change" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": { "condition": "trigger.event !== idea.level" }
        },
        {
          "id": "updateLevel",
          "type": "data:update-item",
          "position": { "x": 560, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": { "level": "{{ trigger.event ?? null }}" }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 760, "y": 0 },
          "data": { "value": "{{ trigger.event ?? null }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-level-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-level-2", "source": "guardIdea", "sourceHandle": "true", "target": "guardChanged" },
        { "id": "e-idea-level-3", "source": "guardChanged", "sourceHandle": "true", "target": "updateLevel" },
        { "id": "e-idea-level-4", "source": "updateLevel", "target": "output" }
      ]
    },
    "updateType": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "change" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": { "condition": "trigger.event !== idea.type" }
        },
        {
          "id": "updateType",
          "type": "data:update-item",
          "position": { "x": 560, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": { "type": "{{ trigger.event ?? null }}" }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 760, "y": 0 },
          "data": { "value": "{{ trigger.event ?? null }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-type-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-type-2", "source": "guardIdea", "sourceHandle": "true", "target": "guardChanged" },
        { "id": "e-idea-type-3", "source": "guardChanged", "sourceHandle": "true", "target": "updateType" },
        { "id": "e-idea-type-4", "source": "updateType", "target": "output" }
      ]
    },
    "updateStatus": {
      "profile": "ui-action",
      "runtime": "client",
      "trigger": { "type": "ui-event", "event": "change" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": { "condition": "trigger.event !== idea.status" }
        },
        {
          "id": "updateStatus",
          "type": "data:update-item",
          "position": { "x": 560, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": { "status": "{{ trigger.event ?? 'draft' }}" }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 760, "y": 0 },
          "data": { "value": "{{ trigger.event ?? 'draft' }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-status-1", "source": "trigger", "target": "guardIdea" },
        { "id": "e-idea-status-2", "source": "guardIdea", "sourceHandle": "true", "target": "guardChanged" },
        { "id": "e-idea-status-3", "source": "guardChanged", "sourceHandle": "true", "target": "updateStatus" },
        { "id": "e-idea-status-4", "source": "updateStatus", "target": "output" }
      ]
    }
  },
  "constants": {
    "levelItems": [
      { "label": "L1", "value": "L1" },
      { "label": "L2", "value": "L2" },
      { "label": "L3", "value": "L3" },
      { "label": "L4", "value": "L4" }
    ],
    "typeItems": [
      { "label": "goal", "value": "goal" },
      { "label": "non_goal", "value": "non_goal" },
      { "label": "constraint", "value": "constraint" },
      { "label": "invariant", "value": "invariant" },
      { "label": "component", "value": "component" },
      { "label": "decision", "value": "decision" },
      { "label": "principle", "value": "principle" }
    ],
    "statusItems": [
      { "label": "draft", "value": "draft" },
      { "label": "stabilized", "value": "stabilized" }
    ]
  },
  "computed": {
    "idea": "{{ ideas.find((entry) => entry.id === route.params.ideaId) ?? null }}",
    "loading": "{{ ideasLoading }}",
    "backLink": "{{ `/project/${route.params.id}/ideas` }}"
  },
  "props": { "class": "flex h-full flex-col" },
  "children": [
    {
      "component": "div",
      "if": "{{ loading }}",
      "props": { "class": "flex h-full items-center justify-center" },
      "children": [
        {
          "component": "UIcon",
          "props": { "name": "i-lucide-loader-2", "class": "text-muted h-8 w-8 animate-spin" }
        }
      ]
    },
    {
      "component": "div",
      "elseIf": "{{ !idea }}",
      "props": { "class": "text-muted flex h-full flex-col items-center justify-center gap-2" },
      "children": [
        {
          "component": "UIcon",
          "props": { "name": "i-lucide-file-x", "class": "h-12 w-12 opacity-20" }
        },
        {
          "component": "p",
          "children": { "$type": "translation", "en": "Idea not found", "ru": "Идея не найдена" }
        },
        {
          "component": "UButton",
          "props": { "to": "{{ backLink }}", "variant": "link" },
          "children": { "$type": "translation", "en": "Back to ideas", "ru": "Назад к идеям" }
        }
      ]
    },
    {
      "component": "div",
      "else": true,
      "props": { "class": "flex flex-1 flex-col gap-6 overflow-y-auto" },
      "children": [
        {
          "component": "div",
          "props": { "class": "border-default flex items-center justify-between border-b px-6 py-3" },
          "children": [
            {
              "component": "div",
              "props": { "class": "flex items-center gap-3" },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "to": "{{ backLink }}",
                    "variant": "ghost",
                    "size": "sm",
                    "icon": "i-lucide-arrow-left"
                  },
                  "children": { "$type": "translation", "en": "Back to ideas", "ru": "Назад к идеям" }
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-wrap items-center gap-2" },
                  "children": [
                    {
                      "component": "UBadge",
                      "props": {
                        "label": "{{ idea.level || t({ en: 'No level', ru: 'Без уровня' }) }}",
                        "color": "neutral",
                        "variant": "subtle",
                        "class": "bg-primary/10 text-primary text-xs font-semibold"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.type }}",
                      "props": {
                        "label": "{{ idea.type }}",
                        "color": "neutral",
                        "variant": "soft",
                        "size": "sm"
                      }
                    },
                    {
                      "component": "UBadge",
                      "if": "{{ idea.status === 'stabilized' }}",
                      "props": {
                        "label": { "$type": "translation", "en": "Stabilized", "ru": "Стабилизирована" },
                        "color": "success",
                        "variant": "subtle",
                        "size": "sm"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "component": "UButton",
              "props": {
                "color": "error",
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-trash-2"
              },
              "events": { "click": { "flow": "openDeleteModal" } },
              "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
            }
          ]
        },
        {
          "component": "div",
          "props": { "class": "flex flex-col gap-6 px-6 pb-6" },
          "children": [
            {
              "component": "UInput",
              "props": { "size": "lg", "class": "w-full" },
              "model": { "value": "{{ idea.title ?? '' }}" },
              "events": {
                "blur": { "flow": "updateTitle" },
                "keyup.enter": { "flow": "updateTitle" }
              }
            },
            {
              "component": "UTextarea",
              "model": { "value": "{{ idea.description ?? '' }}" },
              "props": {
                "placeholder": {
                  "$type": "translation",
                  "en": "Idea description (optional)",
                  "ru": "Описание идеи (опционально)"
                },
                "rows": 6,
                "class": "w-full"
              },
              "events": { "blur": { "flow": "updateDescription" } }
            },
            {
              "component": "div",
              "props": { "class": "grid grid-cols-3 gap-4" },
              "children": [
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Level", "ru": "Уровень" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.level ?? null }}",
                        "onChange": { "flow": "updateLevel" }
                      },
                      "props": {
                        "items": "{{ levelItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Type", "ru": "Тип" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.type ?? null }}",
                        "onChange": { "flow": "updateType" }
                      },
                      "props": {
                        "items": "{{ typeItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": { "class": "flex flex-col gap-1.5" },
                  "children": [
                    {
                      "component": "label",
                      "props": { "class": "text-muted text-sm font-medium" },
                      "children": { "$type": "translation", "en": "Status", "ru": "Статус" }
                    },
                    {
                      "component": "USelect",
                      "model": {
                        "value": "{{ idea.status ?? 'draft' }}",
                        "onChange": { "flow": "updateStatus" }
                      },
                      "props": {
                        "items": "{{ statusItems }}",
                        "valueKey": "value",
                        "labelKey": "label",
                        "size": "sm",
                        "class": "w-full"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "modal": {
            "vModel": "deleteModalOpen",
            "title": { "$type": "translation", "en": "Delete idea?", "ru": "Удалить идею?" },
            "description": {
              "$type": "translation",
              "en": "Are you sure you want to delete this idea? This action cannot be undone.",
              "ru": "Вы уверены, что хотите удалить эту идею? Это действие необратимо."
            },
            "footer": [
              {
                "component": "UButton",
                "props": { "variant": "ghost" },
                "events": { "click": { "flow": "closeDeleteModal" } },
                "children": { "$type": "translation", "en": "Cancel", "ru": "Отмена" }
              },
              {
                "component": "UButton",
                "props": { "color": "error" },
                "events": { "click": { "flow": "confirmDelete" } },
                "children": { "$type": "translation", "en": "Delete", "ru": "Удалить" }
              }
            ]
          }
        }
      ]
    }
  ]
}
