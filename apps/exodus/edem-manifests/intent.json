{
  "id": "intent-exodus",
  "description": "IDE для построения Edem-приложений через декларативные манифесты",
  "goals": [
    { "id": "G-01", "text": "Создавать и управлять Edem-проектами" },
    { "id": "G-02", "text": "Редактировать data-схемы (коллекции, поля) визуально" },
    { "id": "G-03", "text": "Визуально конструировать flows (ноды, триггеры, эффекты)" },
    { "id": "G-04", "text": "Проектировать UI-компоненты и маршруты" },
    { "id": "G-05", "text": "Генерировать код из манифестов (codegen)" },
    { "id": "G-06", "text": "Использовать AI-агента для помощи в построении приложений" },
    { "id": "G-07", "text": "Запускать и предпросматривать приложения" },
    { "id": "G-08", "text": "Отслеживать трассировку от намерения до кода" }
  ],
  "constraints": [
    { "id": "C-01", "text": "Desktop-first (Electrobun)" },
    { "id": "C-02", "text": "Самореферентность: Exodus — Edem-приложение" },
    { "id": "C-03", "text": "Модульная архитектура (edem-core, edem-data, edem-flows, edem-ui)" },
    { "id": "C-04", "text": "Декларативность: манифесты как контракт" }
  ],
  "non_goals": [
    { "id": "NG-01", "text": "Не заменяет IDE общего назначения (VS Code, WebStorm)" },
    { "id": "NG-02", "text": "Не хостит приложения — только генерирует" }
  ],
  "examples": [
    "Retool, но декларативный и локальный",
    "Appsmith с манифестами вместо кода"
  ]
}
