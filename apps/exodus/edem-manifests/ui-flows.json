            "id": "{{ idea.id }}",
            "data": { "status": "{{ trigger.event ?? 'draft' }}" }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 760, "y": 0 },
          "data": { "value": "{{ trigger.event ?? 'draft' }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-status-1", "source": "trigger", "target": "guardIdea" },
        {
          "id": "e-idea-status-2",
          "source": "guardIdea",
