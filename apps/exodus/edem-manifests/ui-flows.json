{
  "flows": [
    {
      "id": "idea.openDeleteModal",
      "name": "Idea Open Delete Modal",
      "trigger": { "type": "manual" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "openModal",
          "type": "ui:set-state",
          "position": { "x": 200, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": true }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 400, "y": 0 },
          "data": { "value": true }
        }
      ],
      "edges": [
        { "id": "e-idea-open-1", "source": "trigger", "target": "openModal" },
        { "id": "e-idea-open-2", "source": "openModal", "target": "output" }
      ],
      "meta": {
        "profile": "ui-action",
        "runtime": "client",
        "screen": "IdeaPage",
        "uiTrigger": { "type": "ui-event", "event": "click" }
      }
    },
    {
      "id": "idea.closeDeleteModal",
      "name": "Idea Close Delete Modal",
      "trigger": { "type": "manual" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "closeModal",
          "type": "ui:set-state",
          "position": { "x": 200, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": false }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 400, "y": 0 },
          "data": { "value": false }
        }
      ],
      "edges": [
        { "id": "e-idea-close-1", "source": "trigger", "target": "closeModal" },
        { "id": "e-idea-close-2", "source": "closeModal", "target": "output" }
      ],
      "meta": {
        "profile": "ui-action",
        "runtime": "client",
        "screen": "IdeaPage",
        "uiTrigger": { "type": "ui-event", "event": "click" }
      }
    },
    {
      "id": "idea.confirmDelete",
      "name": "Idea Confirm Delete",
      "trigger": { "type": "manual" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "deleteIdea",
          "type": "data:delete-item",
          "position": { "x": 360, "y": 0 },
          "data": { "collection": "ideas", "id": "{{ idea.id }}" }
        },
        {
          "id": "closeModal",
          "type": "ui:set-state",
          "position": { "x": 560, "y": 0 },
          "data": { "state": "deleteModalOpen", "value": false }
        },
        {
          "id": "navigateBack",
          "type": "ui:navigate",
          "position": { "x": 760, "y": 0 },
          "data": { "to": "{{ backLink }}" }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 960, "y": 0 },
          "data": { "value": "{{ backLink }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-delete-1", "source": "trigger", "target": "guardIdea" },
        {
          "id": "e-idea-delete-2",
          "source": "guardIdea",
          "sourceHandle": "true",
          "target": "deleteIdea"
        },
        { "id": "e-idea-delete-3", "source": "deleteIdea", "target": "closeModal" },
        { "id": "e-idea-delete-4", "source": "closeModal", "target": "navigateBack" },
        { "id": "e-idea-delete-5", "source": "navigateBack", "target": "output" }
      ],
      "meta": {
        "profile": "ui-action",
        "runtime": "client",
        "screen": "IdeaPage",
        "uiTrigger": { "type": "ui-event", "event": "click" }
      }
    },
    {
      "id": "idea.updateTitle",
      "name": "Idea Update Title",
      "trigger": { "type": "manual" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardNotEmpty",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": {
            "condition": "String(trigger.event?.target?.value ?? '').trim() !== ''"
          }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 560, "y": 0 },
          "data": {
            "condition": "String(trigger.event?.target?.value ?? '').trim() !== (idea.title ?? '')"
          }
        },
        {
          "id": "updateTitle",
          "type": "data:update-item",
          "position": { "x": 780, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": {
              "title": "{{ String(trigger.event?.target?.value ?? '').trim() }}"
            }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 1000, "y": 0 },
          "data": { "value": "{{ String(trigger.event?.target?.value ?? '').trim() }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-title-1", "source": "trigger", "target": "guardIdea" },
        {
          "id": "e-idea-title-2",
          "source": "guardIdea",
          "sourceHandle": "true",
          "target": "guardNotEmpty"
        },
        {
          "id": "e-idea-title-3",
          "source": "guardNotEmpty",
          "sourceHandle": "true",
          "target": "guardChanged"
        },
        {
          "id": "e-idea-title-4",
          "source": "guardChanged",
          "sourceHandle": "true",
          "target": "updateTitle"
        },
        { "id": "e-idea-title-5", "source": "updateTitle", "target": "output" }
      ],
      "meta": {
        "profile": "ui-action",
        "runtime": "client",
        "screen": "IdeaPage",
        "uiTrigger": { "type": "ui-event", "event": "blur" }
      }
    },
    {
      "id": "idea.updateDescription",
      "name": "Idea Update Description",
      "trigger": { "type": "manual" },
      "nodes": [
        { "id": "trigger", "type": "trigger", "position": { "x": 0, "y": 0 } },
        {
          "id": "guardIdea",
          "type": "guard",
          "position": { "x": 180, "y": 0 },
          "data": { "condition": "idea" }
        },
        {
          "id": "guardChanged",
          "type": "guard",
          "position": { "x": 360, "y": 0 },
          "data": {
            "condition": "String(trigger.event?.target?.value ?? '') !== (idea.description ?? '')"
          }
        },
        {
          "id": "updateDescription",
          "type": "data:update-item",
          "position": { "x": 580, "y": 0 },
          "data": {
            "collection": "ideas",
            "id": "{{ idea.id }}",
            "data": {
              "description": "{{ String(trigger.event?.target?.value ?? '') || null }}"
            }
          }
        },
        {
          "id": "output",
          "type": "output",
          "position": { "x": 800, "y": 0 },
          "data": { "value": "{{ String(trigger.event?.target?.value ?? '') || null }}" }
        }
      ],
      "edges": [
        { "id": "e-idea-desc-1", "source": "trigger", "target": "guardIdea" },
        {
          "id": "e-idea-desc-2",
          "source": "guardIdea",
          "sourceHandle": "true",
          "target": "guardChanged"
        },
        {
          "id": "e-idea-desc-3",
          "source": "guardChanged",
          "sourceHandle": "true",
          "target": "updateDescription"
        },
        { "id": "e-idea-desc-4", "source": "updateDescription", "target": "output" }
      ],
      "meta": {
        "profile": "ui-action",
        "runtime": "client",
        "screen": "IdeaPage",
        "uiTrigger": { "type": "ui-event", "event": "blur" }
      }
    },
