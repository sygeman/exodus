{
  "routes": [
    {
      "path": "/",
      "redirect": "/projects"
    },
    {
      "path": "/projects",
      "root": "ProjectsListPage"
    },
    {
      "path": "/project/:id/overview",
      "root": "ProjectPage"
    },
    {
      "path": "/project/:id/ideas",
      "root": "ProjectIdeasPage"
    },
    {
      "path": "/project/:id/ideas/:ideaId",
      "root": "IdeaPage"
    },
    {
      "path": "/project/:id/settings",
      "root": "ProjectSettingsPage"
    },
    {
      "path": "/debug/logs",
      "root": "DebugLogs"
    },
    {
      "path": "/debug/state",
      "root": "DebugState"
    },
    {
      "path": "/settings/appearance",
      "root": "SettingsAppearance"
    },
    {
      "path": "/settings/language",
      "root": "SettingsLanguage"
    },
    {
      "path": "/:pathMatch(.*)*",
      "root": "NotFound"
    }
  ],
  "components": {
    "AppLayout": {
      "component": "div",
      "props": {
        "class": "flex h-screen bg-[var(--ui-bg-elevated)] pr-2 pb-2"
      },
      "children": [
        {
          "component": "AppSidebar",
          "props": {
            "class": "pt-8"
          }
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-1 flex-col overflow-hidden"
          },
          "children": [
            {
              "component": "AppTopMenu"
            },
            {
              "component": "main",
              "props": {
                "class": "flex-1 overflow-hidden rounded-xl border border-[var(--ui-border)] bg-[var(--ui-bg)] shadow-sm"
              },
              "children": [
                {
                  "component": "RouterView"
                }
              ]
            }
          ]
        }
      ]
    },
    "AppSidebar": {
      "component": "aside",
      "props": {
        "class": "flex w-56 flex-col border-r border-[var(--ui-border)] bg-[var(--ui-bg)]"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center gap-2 px-4 pb-4"
          },
          "children": [
            {
              "component": "UIcon",
              "props": {
                "name": "i-lucide-box",
                "class": "text-primary text-lg"
              }
            },
            {
              "component": "span",
              "props": {
                "class": "font-bold"
              },
              "children": "Exodus"
            }
          ]
        },
        {
          "component": "UNavigationMenu",
          "props": {
            "orientation": "vertical"
          },
          "bind": {
            "items": [
              {
                "label": "Projects",
                "icon": "i-lucide-folder",
                "to": "/projects"
              },
              {
                "label": "Debug Logs",
                "icon": "i-lucide-terminal",
                "to": "/debug/logs"
              },
              {
                "label": "Debug State",
                "icon": "i-lucide-database",
                "to": "/debug/state"
              },
              {
                "label": "Appearance",
                "icon": "i-lucide-palette",
                "to": "/settings/appearance"
              },
              {
                "label": "Language",
                "icon": "i-lucide-globe",
                "to": "/settings/language"
              }
            ],
            "item": {
              "component": "div",
              "props": {
                "class": "flex items-center gap-2"
              },
              "children": [
                {
                  "component": "UIcon",
                  "props": {
                    "name": "{{ item.icon }}"
                  }
                },
                {
                  "component": "span",
                  "children": "{{ item.label }}"
                }
              ]
            }
          }
        }
      ]
    },
    "AppTopMenu": {
      "component": "div",
      "props": {
        "class": "flex items-center justify-between border-b border-[var(--ui-border)] px-4 py-2"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center gap-2"
          },
          "children": [
            {
              "component": "UButton",
              "props": {
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-arrow-left"
              },
              "events": {
                "click": {
                  "navigate": "/projects"
                }
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex items-center gap-2"
          },
          "children": [
            {
              "component": "span",
              "props": {
                "class": "text-xs text-muted"
              },
              "children": "v0.42.0"
            }
          ]
        }
      ]
    },
    "ProjectsListPage": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col p-6"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center gap-2 mb-4"
          },
          "children": [
            {
              "component": "h1",
              "props": {
                "class": "text-lg font-bold"
              },
              "children": "Projects"
            },
            {
              "component": "UBadge",
              "props": {
                "color": "neutral",
                "variant": "subtle"
              },
              "children": "{{ projects.length }}"
            }
          ]
        },
        {
          "component": "UButton",
          "props": {
            "size": "sm"
          },
          "events": {
            "click": {
              "flow": "createProject"
            }
          },
          "children": [
            {
              "component": "UIcon",
              "props": {
                "name": "i-lucide-plus"
              }
            },
            {
              "component": "span",
              "children": "New project"
            }
          ]
        },
        {
          "component": "UScrollArea",
          "props": {
            "class": "mt-4 flex-1"
          },
          "bind": {
            "collection": "projects",
            "sort": [
              "sort_order"
            ],
            "item": {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3 rounded-lg border p-3 transition-colors hover:bg-elevated"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex h-10 w-10 items-center justify-center rounded-full text-xs font-bold text-inverted",
                    "style": "background-color: {{ item.color }}"
                  },
                  "children": "{{ item.name }}"
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ item.name }}"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "{{ item.description }}"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "ProjectPage": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col p-6"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
          },
          "children": [
            {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3 rounded-lg border p-4 transition-colors hover:bg-elevated"
              },
              "children": [
                {
                  "component": "UIcon",
                  "props": {
                    "name": "i-lucide-lightbulb",
                    "class": "text-primary"
                  }
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "Ideas"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "text-2xl font-bold"
                      },
                      "children": "{{ ideas.length }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "component": "h3",
          "props": {
            "class": "mb-4 font-bold"
          },
          "children": "Recent Ideas"
        },
        {
          "component": "div",
          "bind": {
            "collection": "ideas",
            "filter": {
              "project_id": {
                "_eq": "{{ context.projectId }}"
              }
            },
            "sort": [
              "-created_at"
            ],
            "item": {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3 rounded-lg border p-3 transition-colors hover:bg-elevated"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold text-inverted",
                    "style": "background-color: {{ getLevelColor(item.level) }}"
                  },
                  "children": "{{ item.level }}"
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ item.title }}"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "{{ item.type }}"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "ProjectIdeasPage": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col p-6"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "mb-4 flex items-center justify-between"
          },
          "children": [
            {
              "component": "h2",
              "props": {
                "class": "text-lg font-bold"
              },
              "children": "Ideas"
            },
            {
              "component": "UButton",
              "props": {
                "size": "sm"
              },
              "events": {
                "click": {
                  "flow": "createIdea",
                  "input": {
                    "projectId": "{{ context.projectId }}"
                  }
                }
              },
              "children": [
                {
                  "component": "UIcon",
                  "props": {
                    "name": "i-lucide-plus"
                  }
                },
                {
                  "component": "span",
                  "children": "New Idea"
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex flex-col gap-3"
          },
          "bind": {
            "collection": "ideas",
            "filter": {
              "project_id": {
                "_eq": "{{ context.projectId }}"
              }
            },
            "sort": [
              "-created_at"
            ],
            "item": {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3 rounded-lg border p-3 transition-colors hover:bg-elevated"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold text-inverted",
                    "style": "background-color: {{ getLevelColor(item.level) }}"
                  },
                  "children": "{{ item.level }}"
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex flex-col"
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ item.title }}"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "{{ item.type }}"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "IdeaPage": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col"
      },
      "bind": {
        "collection": "ideas",
        "filter": {
          "id": {
            "_eq": "{{ context.ideaId }}"
          }
        }
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center justify-between border-b px-6 py-3"
          },
          "children": [
            {
              "component": "div",
              "props": {
                "class": "flex items-center gap-3"
              },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "variant": "ghost",
                    "size": "sm",
                    "icon": "i-lucide-arrow-left"
                  },
                  "events": {
                    "click": {
                      "navigate": "/project/{{ context.projectId }}/ideas"
                    }
                  }
                },
                {
                  "component": "UBadge",
                  "props": {
                    "color": "neutral",
                    "variant": "subtle"
                  },
                  "children": "{{ item.level }}"
                },
                {
                  "component": "UBadge",
                  "props": {
                    "color": "neutral",
                    "variant": "soft",
                    "size": "sm"
                  },
                  "children": "{{ item.type }}"
                }
              ]
            },
            {
              "component": "UButton",
              "props": {
                "color": "error",
                "variant": "ghost",
                "size": "sm",
                "icon": "i-lucide-trash-2"
              },
              "events": {
                "click": {
                  "action": "deleteItem",
                  "collection": "ideas",
                  "data": {
                    "id": "{{ context.ideaId }}"
                  }
                }
              }
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex-1 overflow-y-auto px-6 pb-6"
          },
          "children": [
            {
              "component": "UInput",
              "props": {
                "modelValue": "{{ item.title }}",
                "size": "lg",
                "class": "mb-4 w-full"
              },
              "events": {
                "update:modelValue": {
                  "action": "updateItem",
                  "collection": "ideas",
                  "data": {
                    "id": "{{ context.ideaId }}",
                    "title": "{{ event }}"
                  }
                }
              }
            },
            {
              "component": "UTextarea",
              "props": {
                "modelValue": "{{ item.description }}",
                "rows": 6,
                "placeholder": "Describe this idea...",
                "class": "mb-6 w-full"
              },
              "events": {
                "update:modelValue": {
                  "action": "updateItem",
                  "collection": "ideas",
                  "data": {
                    "id": "{{ context.ideaId }}",
                    "description": "{{ event }}"
                  }
                }
              }
            },
            {
              "component": "div",
              "props": {
                "class": "grid grid-cols-1 gap-4 sm:grid-cols-3"
              },
              "children": [
                {
                  "component": "div",
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "mb-1 block text-sm font-medium"
                      },
                      "children": "Level"
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ item.level }}",
                        "items": [
                          "L0",
                          "L1",
                          "L2",
                          "L3",
                          "L4"
                        ],
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:modelValue": {
                          "action": "updateItem",
                          "collection": "ideas",
                          "data": {
                            "id": "{{ context.ideaId }}",
                            "level": "{{ event }}"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "mb-1 block text-sm font-medium"
                      },
                      "children": "Type"
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ item.type }}",
                        "items": [
                          "goal",
                          "non_goal",
                          "constraint",
                          "invariant",
                          "component",
                          "decision",
                          "principle"
                        ],
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:modelValue": {
                          "action": "updateItem",
                          "collection": "ideas",
                          "data": {
                            "id": "{{ context.ideaId }}",
                            "type": "{{ event }}"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "component": "div",
                  "children": [
                    {
                      "component": "label",
                      "props": {
                        "class": "mb-1 block text-sm font-medium"
                      },
                      "children": "Status"
                    },
                    {
                      "component": "USelect",
                      "props": {
                        "modelValue": "{{ item.status }}",
                        "items": [
                          "draft",
                          "active",
                          "stabilized",
                          "archived"
                        ],
                        "size": "sm",
                        "class": "w-full"
                      },
                      "events": {
                        "update:modelValue": {
                          "action": "updateItem",
                          "collection": "ideas",
                          "data": {
                            "id": "{{ context.ideaId }}",
                            "status": "{{ event }}"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "ProjectSettingsPage": {
      "component": "div",
      "props": {
        "class": "overflow-y-auto p-10"
      },
      "bind": {
        "collection": "projects",
        "filter": {
          "id": {
            "_eq": "{{ context.projectId }}"
          }
        }
      },
      "children": [
        {
          "component": "h1",
          "props": {
            "class": "mb-6 text-lg font-bold"
          },
          "children": "Settings"
        },
        {
          "component": "section",
          "children": [
            {
              "component": "div",
              "props": {
                "class": "border-b py-4"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "mb-2"
                  },
                  "children": [
                    {
                      "component": "h3",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "Name"
                    },
                    {
                      "component": "p",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "Display name of the project"
                    }
                  ]
                },
                {
                  "component": "UInput",
                  "props": {
                    "modelValue": "{{ item.name }}",
                    "class": "max-w-md"
                  },
                  "events": {
                    "update:modelValue": {
                      "action": "updateItem",
                      "collection": "projects",
                      "data": {
                        "id": "{{ context.projectId }}",
                        "name": "{{ event }}"
                      }
                    }
                  }
                }
              ]
            },
            {
              "component": "div",
              "props": {
                "class": "border-b py-4"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "mb-2"
                  },
                  "children": [
                    {
                      "component": "h3",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "Color"
                    },
                    {
                      "component": "p",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "Project color for sidebar"
                    }
                  ]
                },
                {
                  "component": "div",
                  "props": {
                    "class": "flex gap-2"
                  },
                  "bind": {
                    "items": [
                      "#ef4444",
                      "#f97316",
                      "#eab308",
                      "#22c55e",
                      "#06b6d4",
                      "#3b82f6",
                      "#8b5cf6",
                      "#ec4899"
                    ],
                    "item": {
                      "component": "button",
                      "props": {
                        "class": "h-6 w-6 rounded-full transition-all",
                        "style": "background-color: {{ item }}"
                      },
                      "events": {
                        "click": {
                          "action": "updateItem",
                          "collection": "projects",
                          "data": {
                            "id": "{{ context.projectId }}",
                            "color": "{{ item }}"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "component": "div",
              "props": {
                "class": "py-4"
              },
              "children": [
                {
                  "component": "div",
                  "props": {
                    "class": "mb-2"
                  },
                  "children": [
                    {
                      "component": "h3",
                      "props": {
                        "class": "font-medium text-error"
                      },
                      "children": "Delete project"
                    },
                    {
                      "component": "p",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "Permanently delete this project and all its ideas."
                    }
                  ]
                },
                {
                  "component": "UButton",
                  "props": {
                    "color": "error",
                    "variant": "outline"
                  },
                  "events": {
                    "click": {
                      "flow": "deleteProject",
                      "input": {
                        "projectId": "{{ context.projectId }}"
                      }
                    }
                  },
                  "children": [
                    {
                      "component": "UIcon",
                      "props": {
                        "name": "i-lucide-trash-2"
                      }
                    },
                    {
                      "component": "span",
                      "children": "Delete"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "DebugLogs": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center justify-between border-b px-4 py-2"
          },
          "children": [
            {
              "component": "h1",
              "props": {
                "class": "font-bold"
              },
              "children": "Logs"
            },
            {
              "component": "div",
              "props": {
                "class": "flex items-center gap-2"
              },
              "children": [
                {
                  "component": "UButton",
                  "props": {
                    "variant": "subtle"
                  },
                  "events": {
                    "click": {
                      "flow": "togglePauseLogs"
                    }
                  },
                  "children": "Pause"
                },
                {
                  "component": "UButton",
                  "props": {
                    "variant": "subtle",
                    "color": "error"
                  },
                  "events": {
                    "click": {
                      "flow": "clearLogs"
                    }
                  },
                  "children": "Clear"
                }
              ]
            }
          ]
        },
        {
          "component": "div",
          "props": {
            "class": "flex items-center gap-2 border-b px-4 py-2"
          },
          "children": [
            {
              "component": "USelectMenu",
              "props": {
                "placeholder": "Filter by level...",
                "class": "w-28"
              },
              "events": {
                "update:modelValue": {
                  "flow": "setLogFilter",
                  "input": {
                    "level": "{{ event }}"
                  }
                }
              }
            },
            {
              "component": "USelectMenu",
              "props": {
                "placeholder": "Filter by source...",
                "class": "w-28"
              },
              "events": {
                "update:modelValue": {
                  "flow": "setLogFilter",
                  "input": {
                    "source": "{{ event }}"
                  }
                }
              }
            },
            {
              "component": "UInput",
              "props": {
                "placeholder": "Search logs...",
                "class": "min-w-0 flex-1"
              },
              "events": {
                "update:modelValue": {
                  "flow": "setLogFilter",
                  "input": {
                    "text": "{{ event }}"
                  }
                }
              }
            }
          ]
        },
        {
          "component": "UScrollArea",
          "props": {
            "class": "min-h-0 flex-1"
          },
          "bind": {
            "collection": "logs",
            "sort": [
              "-created_at"
            ],
            "item": {
              "component": "div",
              "props": {
                "class": "group flex items-center gap-3 border-b px-4 py-2 transition-colors hover:bg-elevated"
              },
              "children": [
                {
                  "component": "span",
                  "props": {
                    "class": "w-20 text-xs text-muted font-mono"
                  },
                  "children": "{{ item.created_at }}"
                },
                {
                  "component": "UBadge",
                  "props": {
                    "color": "{{ item.level }}",
                    "variant": "subtle",
                    "class": "text-[10px] uppercase"
                  },
                  "children": "{{ item.level }}"
                },
                {
                  "component": "span",
                  "props": {
                    "class": "w-24 truncate text-xs text-muted"
                  },
                  "children": "{{ item.source }}"
                },
                {
                  "component": "span",
                  "props": {
                    "class": "flex-1 truncate text-sm"
                  },
                  "children": "{{ item.message }}"
                },
                {
                  "component": "UButton",
                  "props": {
                    "variant": "ghost",
                    "size": "xs",
                    "icon": "i-lucide-copy",
                    "class": "opacity-0 group-hover:opacity-100"
                  },
                  "events": {
                    "click": {
                      "flow": "copyLog",
                      "input": {
                        "logId": "{{ item.id }}"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "DebugState": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col"
      },
      "children": [
        {
          "component": "div",
          "props": {
            "class": "flex items-center justify-between border-b px-4 py-2"
          },
          "children": [
            {
              "component": "h1",
              "props": {
                "class": "font-bold"
              },
              "children": "State"
            },
            {
              "component": "UButton",
              "props": {
                "variant": "subtle"
              },
              "events": {
                "click": {
                  "flow": "refreshState"
                }
              },
              "children": "Refresh"
            }
          ]
        },
        {
          "component": "UScrollArea",
          "props": {
            "class": "min-h-0 flex-1"
          },
          "bind": {
            "collection": "app_state",
            "item": {
              "component": "pre",
              "props": {
                "class": "p-4 text-xs font-mono"
              },
              "children": "{{ JSON.stringify(item, null, 2) }}"
            }
          }
        }
      ]
    },
    "SettingsAppearance": {
      "component": "div",
      "props": {
        "class": "overflow-y-auto p-10"
      },
      "children": [
        {
          "component": "h1",
          "props": {
            "class": "mb-6 text-lg font-bold"
          },
          "children": "Settings"
        },
        {
          "component": "section",
          "children": [
            {
              "component": "div",
              "props": {
                "class": "flex items-center justify-between"
              },
              "children": [
                {
                  "component": "div",
                  "children": [
                    {
                      "component": "h3",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "Dark Mode"
                    },
                    {
                      "component": "p",
                      "props": {
                        "class": "text-sm text-muted"
                      },
                      "children": "Toggle dark mode appearance"
                    }
                  ]
                },
                {
                  "component": "USwitch",
                  "events": {
                    "update:modelValue": {
                      "flow": "toggleDarkMode"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "SettingsLanguage": {
      "component": "div",
      "props": {
        "class": "overflow-y-auto p-10"
      },
      "children": [
        {
          "component": "h1",
          "props": {
            "class": "mb-6 text-lg font-bold"
          },
          "children": "Settings"
        },
        {
          "component": "section",
          "children": [
            {
              "component": "div",
              "props": {
                "class": "mb-4"
              },
              "children": [
                {
                  "component": "h3",
                  "props": {
                    "class": "font-medium"
                  },
                  "children": "Language"
                },
                {
                  "component": "p",
                  "props": {
                    "class": "text-sm text-muted"
                  },
                  "children": "Select your preferred language"
                }
              ]
            },
            {
              "component": "div",
              "props": {
                "class": "flex flex-col gap-2"
              },
              "bind": {
                "items": [
                  {
                    "value": "en",
                    "label": "English",
                    "flag": "🇺🇸"
                  },
                  {
                    "value": "ru",
                    "label": "Russian",
                    "flag": "🇷🇺"
                  },
                  {
                    "value": "de",
                    "label": "German",
                    "flag": "🇩🇪"
                  },
                  {
                    "value": "fr",
                    "label": "French",
                    "flag": "🇫🇷"
                  },
                  {
                    "value": "ja",
                    "label": "Japanese",
                    "flag": "🇯🇵"
                  }
                ],
                "item": {
                  "component": "button",
                  "props": {
                    "class": "flex items-center gap-3 rounded-lg border p-3 transition-colors hover:bg-elevated"
                  },
                  "events": {
                    "click": {
                      "flow": "setLocale",
                      "input": {
                        "locale": "{{ item.value }}"
                      }
                    }
                  },
                  "children": [
                    {
                      "component": "span",
                      "props": {
                        "class": "text-lg"
                      },
                      "children": "{{ item.flag }}"
                    },
                    {
                      "component": "span",
                      "props": {
                        "class": "font-medium"
                      },
                      "children": "{{ item.label }}"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "NotFound": {
      "component": "div",
      "props": {
        "class": "flex h-full flex-col items-center justify-center gap-4"
      },
      "children": [
        {
          "component": "UIcon",
          "props": {
            "name": "i-lucide-ghost",
            "class": "h-16 opacity-20"
          }
        },
        {
          "component": "div",
          "props": {
            "class": "text-center"
          },
          "children": [
            {
              "component": "h1",
              "props": {
                "class": "text-lg font-bold"
              },
              "children": "Page not found"
            },
            {
              "component": "p",
              "props": {
                "class": "text-muted"
              },
              "children": "The page you're looking for doesn't exist."
            }
          ]
        },
        {
          "component": "UButton",
          "props": {
            "to": "/projects",
            "color": "primary"
          },
          "children": "Go to projects"
        }
      ]
    }
  }
}