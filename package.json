{
  "name": "exodus-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:exodus": "turbo run dev --filter=exodus",
    "codegen": "turbo run compare --filter=@exodus/edem-codegen",
    "compare": "turbo run compare --filter=@exodus/edem-codegen",
    "generated:install": "bun install",
    "generated:format": "oxfmt apps/exodus-generated",
    "generated:lint": "oxlint apps/exodus-generated",
    "build": "turbo run build",
    "build:stable": "turbo run build:stable",
    "check-types": "turbo run check-types",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "turbo run //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix",
    "check": "turbo run check",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tailwindcss": "1.3.5",
    "turbo": "2.10.5"
  },
  "packageManager": "bun@1.3.14"
}
